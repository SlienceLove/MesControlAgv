<UserControl x:Class="MesControlAgv.Wpf.Experiments.ExperimentPlanManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             AutomationProperties.AutomationId="ExperimentPlanManagementView"
             d:DesignHeight="760"
             d:DesignWidth="1380"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="实验方案" />
                <TextBlock Margin="0,3,0,0" Foreground="#667085" Text="{Binding CurrentVersion}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PlanRefreshButton" AutomationProperties.AutomationId="ExperimentPlanRefreshButton"
                        Margin="6,0,0,0" Padding="12,7" Command="{Binding RefreshCommand}" Content="刷新" />
                <Button x:Name="PlanNewButton" AutomationProperties.AutomationId="ExperimentPlanNewButton"
                        Margin="6,0,0,0" Padding="12,7" Command="{Binding NewPlanCommand}" Content="新建方案" />
                <Button x:Name="PlanSaveButton" AutomationProperties.AutomationId="ExperimentPlanSaveButton"
                        Margin="6,0,0,0" Padding="12,7" Command="{Binding SaveDraftCommand}" Content="保存草稿" />
                <Button x:Name="PlanValidateButton" AutomationProperties.AutomationId="ExperimentPlanValidateButton"
                        Margin="6,0,0,0" Padding="12,7" Command="{Binding ValidateCommand}" Content="校验" />
                <Button x:Name="PlanPublishButton" AutomationProperties.AutomationId="ExperimentPlanPublishButton"
                        Margin="6,0,0,0" Padding="12,7" Background="#1769AA" Foreground="White"
                        Command="{Binding PublishCommand}" Content="发布" />
                <Button x:Name="PlanNextDraftButton" AutomationProperties.AutomationId="ExperimentPlanNextDraftButton"
                        Margin="6,0,0,0" Padding="12,7" Command="{Binding CreateNextDraftCommand}" Content="复制为下一草稿" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Margin="0,0,0,3" Foreground="#667085" Text="操作者" />
                <TextBox MinHeight="30" Padding="6,4" Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Margin="0,0,0,3" Foreground="#667085" Text="变更理由" />
                <TextBox MinHeight="30" Padding="6,4" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,3" Foreground="#667085" Text="完整度" />
                <TextBlock MinHeight="30" Padding="6,5" Background="#F6F8FA" FontWeight="SemiBold"
                           Text="{Binding ValidationSummary}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" MinHeight="280">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="165" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,6" FontSize="15" FontWeight="SemiBold" Text="方案目录" />
                <DataGrid x:Name="PlanGrid" AutomationProperties.AutomationId="ExperimentPlanGrid"
                          Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Header="名称" Binding="{Binding Name}" />
                        <DataGridTextColumn Width="42" Header="版本" Binding="{Binding Version}" />
                        <DataGridTextColumn Width="62" Header="状态" Binding="{Binding Status}" />
                        <DataGridTextColumn Width="78" Header="完整度" Binding="{Binding Completeness}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#EAECF0" />

            <Grid Grid.Column="2" Margin="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,6" FontSize="15" FontWeight="SemiBold" Text="版本" />
                <DataGrid x:Name="PlanVersionGrid" AutomationProperties.AutomationId="ExperimentPlanVersionGrid"
                          Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="42" Header="版本" Binding="{Binding VersionText}" />
                        <DataGridTextColumn Width="60" Header="状态" Binding="{Binding Status}" />
                        <DataGridTextColumn Width="*" Header="校验" Binding="{Binding Validation}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#EAECF0" />

            <Grid Grid.Column="4" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" Text="方案详情" />
                    <TextBlock DockPanel.Dock="Right" Foreground="#667085" Text="{Binding CurrentVersion}" />
                </DockPanel>
                <TabControl x:Name="PlanDetailTabs" AutomationProperties.AutomationId="ExperimentPlanDetailTabs"
                            Grid.Row="1" SelectedIndex="{Binding DetailTabIndex}">
                    <TabItem Header="基础信息">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,7,10,0" Text="方案名称" />
                                <TextBox Grid.Column="1" MinHeight="30" Padding="6,4" IsEnabled="{Binding CanEdit}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Margin="0,12,10,0" Text="说明" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" MinHeight="54" Padding="6,4"
                                         AcceptsReturn="True" IsEnabled="{Binding CanEdit}" TextWrapping="Wrap"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Margin="0,12,10,0" Text="固定流程版本" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" MinHeight="30"
                                          DisplayMemberPath="Display" IsEnabled="{Binding CanEdit}"
                                          ItemsSource="{Binding PublishedWorkflowVersions}"
                                          SelectedItem="{Binding SelectedWorkflowVersion}" />
                                <TextBlock Grid.Row="3" Margin="0,12,10,0" Text="Profile" />
                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox MinHeight="30" Padding="6,4" IsEnabled="{Binding CanEdit}"
                                             Text="{Binding ProfileProductId, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" MinHeight="30" Padding="6,4" IsEnabled="{Binding CanEdit}"
                                             Text="{Binding ProfileVersion, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Grid.Row="4" Margin="0,12,10,0" Text="布局 ID" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" MinHeight="30" Padding="6,4"
                                         IsEnabled="{Binding CanEdit}" Text="{Binding LayoutId, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="物料">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,5"
                                    Command="{Binding AddMaterialCommand}" Content="添加物料" />
                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Materials}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="100" Header="物料 ID" Binding="{Binding MaterialId, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="*" Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="70" Header="数量" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="70" Header="单位" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="120" Header="规格" Binding="{Binding Specification, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Width="52" Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="5,2" Content="移除"
                                                        Command="{Binding DataContext.RemoveMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="默认参数">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,5"
                                    Command="{Binding AddParameterCommand}" Content="添加参数" />
                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Parameters}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="180" Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="*" Header="默认值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Width="52" Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="5,2" Content="移除"
                                                        Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="资源要求">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,5"
                                    Command="{Binding AddResourceCommand}" Content="添加资源要求" />
                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsEnabled="{Binding CanEdit}" ItemsSource="{Binding ResourceRequirements}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="105" Header="类型">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.ResourceTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding ResourceType, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="120" Header="资源 ID" Binding="{Binding ResourceId, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="*" Header="能力 ID" Binding="{Binding CapabilityId, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="55" Header="数量" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridCheckBoxColumn Width="55" Header="互斥" Binding="{Binding Exclusive, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Width="52" Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="5,2" Content="移除"
                                                        Command="{Binding DataContext.RemoveResourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,5">
                <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" Text="完整度问题" />
                <TextBlock DockPanel.Dock="Right" Foreground="#667085" Text="{Binding ValidationSummary}" />
            </DockPanel>
            <DataGrid x:Name="PlanValidationGrid" AutomationProperties.AutomationId="ExperimentPlanValidationGrid"
                      Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      ItemsSource="{Binding ValidationIssues}" SelectedItem="{Binding SelectedValidationIssue}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="60" Header="级别" Binding="{Binding Severity}" />
                    <DataGridTextColumn Width="210" Header="代码" Binding="{Binding Code}" />
                    <DataGridTextColumn Width="*" Header="问题" Binding="{Binding Message}" />
                    <DataGridTextColumn Width="130" Header="字段" Binding="{Binding Field}" />
                    <DataGridTextColumn Width="150" Header="资源" Binding="{Binding Resource}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="#475467" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="#B42318"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
