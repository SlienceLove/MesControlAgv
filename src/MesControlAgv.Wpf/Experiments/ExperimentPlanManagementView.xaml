<UserControl x:Class="MesControlAgv.Wpf.Experiments.ExperimentPlanManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             AutomationProperties.AutomationId="ExperimentPlanManagementView"
             d:DesignHeight="760"
             d:DesignWidth="1380"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="实验方案" />
                <TextBlock Margin="0,3,0,0" Foreground="#667085" Text="{Binding CurrentVersion}" />
                <WrapPanel Margin="0,10,0,0">
                <Button x:Name="PlanRefreshButton" AutomationProperties.AutomationId="ExperimentPlanRefreshButton"
                        Margin="6,0,0,0" Padding="12,7" Command="{Binding RefreshCommand}" Content="刷新" />
                <Button x:Name="PlanNewButton" AutomationProperties.AutomationId="ExperimentPlanNewButton"
                        Margin="6,0,0,0" Padding="12,7" Command="{Binding NewPlanCommand}" Content="新建方案" />
                <Button x:Name="PlanSaveButton" AutomationProperties.AutomationId="ExperimentPlanSaveButton"
                        Margin="6,0,0,0" Padding="12,7" Command="{Binding SaveDraftCommand}" Content="保存草稿" />
                <Button x:Name="PlanValidateButton" AutomationProperties.AutomationId="ExperimentPlanValidateButton"
                        Margin="6,0,0,0" Padding="12,7" Command="{Binding ValidateCommand}" Content="校验" />
                <Button x:Name="PlanPublishButton" AutomationProperties.AutomationId="ExperimentPlanPublishButton"
                        Margin="6,0,0,0" Padding="12,7" Background="#1769AA" Foreground="White"
                        Command="{Binding PublishCommand}" Content="发布" />
                <Button x:Name="PlanNextDraftButton" AutomationProperties.AutomationId="ExperimentPlanNextDraftButton"
                        Margin="6,0,0,0" Padding="12,7" Command="{Binding CreateNextDraftCommand}" Content="复制为下一草稿" />
                </WrapPanel>
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Width="210" Margin="0,0,12,8">
                <TextBlock Margin="0,0,0,3" Foreground="#667085" Text="操作者" />
                <TextBox MinHeight="30" Padding="6,4" Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Width="320" Margin="0,0,12,8">
                <TextBlock Margin="0,0,0,3" Foreground="#667085" Text="变更理由" />
                <TextBox MinHeight="30" Padding="6,4" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Width="260" Margin="0,0,0,8">
                <TextBlock Margin="0,0,0,3" Foreground="#667085" Text="完整度" />
                <TextBlock MinHeight="30" Padding="6,5" Background="#F6F8FA" FontWeight="SemiBold"
                           Text="{Binding ValidationSummary}" />
            </StackPanel>
        </WrapPanel>
        <!-- The editor panes use adjustable ratios below 1100px so the plan,
             version and detail views remain visible instead of pushing the
             detail tabs outside the window. -->
        <Grid x:Name="PlanWorkspaceGrid" Grid.Row="2" MinHeight="280" MinWidth="0"
              SizeChanged="PlanWorkspaceGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PlanCatalogColumn" Width="330" MinWidth="0" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="PlanVersionColumn" Width="165" MinWidth="0" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="PlanDetailsColumn" Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="PlanCatalogPane" Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,6" FontSize="15" FontWeight="SemiBold" Text="方案目录" />
                <DataGrid x:Name="PlanGrid" AutomationProperties.AutomationId="ExperimentPlanGrid"
                          Grid.Row="1" MinWidth="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" MinWidth="80" Header="名称" Binding="{Binding Name}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="42" MinWidth="36" Header="版本" Binding="{Binding Version}" />
                        <DataGridTextColumn Width="62" MinWidth="48" Header="状态" Binding="{Binding Status}" />
                        <DataGridTextColumn Width="78" MinWidth="60" Header="完整度" Binding="{Binding Completeness}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter x:Name="PlanCatalogSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#EAECF0" />

            <Grid x:Name="PlanVersionPane" Grid.Column="2" Margin="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,6" FontSize="15" FontWeight="SemiBold" Text="版本" />
                <DataGrid x:Name="PlanVersionGrid" AutomationProperties.AutomationId="ExperimentPlanVersionGrid"
                          Grid.Row="1" MinWidth="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="42" MinWidth="36" Header="版本" Binding="{Binding VersionText}" />
                        <DataGridTextColumn Width="60" MinWidth="48" Header="状态" Binding="{Binding Status}" />
                        <DataGridTextColumn Width="*" MinWidth="80" Header="校验" Binding="{Binding Validation}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter x:Name="PlanVersionSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#EAECF0" />

            <Grid x:Name="PlanDetailsPane" Grid.Column="4" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" Text="方案详情" />
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" HorizontalAlignment="Right"
                               Foreground="#667085" Text="{Binding CurrentVersion}" />
                </DockPanel>
                <TabControl x:Name="PlanDetailTabs" AutomationProperties.AutomationId="ExperimentPlanDetailTabs"
                            Grid.Row="1" SelectedIndex="{Binding DetailTabIndex}">
                    <TabItem Header="基础信息">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,7,10,0" Text="方案名称" />
                                <TextBox Grid.Column="1" MinHeight="30" Padding="6,4" IsEnabled="{Binding CanEdit}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Margin="0,12,10,0" Text="说明" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" MinHeight="54" Padding="6,4"
                                         AcceptsReturn="True" IsEnabled="{Binding CanEdit}" TextWrapping="Wrap"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Margin="0,12,10,0" Text="首个流程（兼容）" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" MinHeight="30"
                                          DisplayMemberPath="Display" IsEnabled="{Binding CanEdit}"
                                          ItemsSource="{Binding PublishedWorkflowVersions}"
                                          SelectedItem="{Binding SelectedWorkflowVersion}" />
                                <TextBlock Grid.Row="3" Margin="0,12,10,0" Text="Profile" />
                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox MinHeight="30" Padding="6,4" IsEnabled="{Binding CanEdit}"
                                             Text="{Binding ProfileProductId, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" MinHeight="30" Padding="6,4" IsEnabled="{Binding CanEdit}"
                                             Text="{Binding ProfileVersion, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Grid.Row="4" Margin="0,12,10,0" Text="布局 ID" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" MinHeight="30" Padding="6,4"
                                         IsEnabled="{Binding CanEdit}" Text="{Binding LayoutId, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="物料">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,5"
                                    Command="{Binding AddMaterialCommand}" Content="添加物料" />
                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Materials}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="100" Header="物料 ID" Binding="{Binding MaterialId, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="*" Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="70" Header="数量" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="70" Header="单位" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="120" Header="规格" Binding="{Binding Specification, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Width="52" Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="5,2" Content="移除"
                                                        Command="{Binding DataContext.RemoveMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="默认参数">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,5"
                                    Command="{Binding AddParameterCommand}" Content="添加参数" />
                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Parameters}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="180" Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="*" Header="默认值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Width="52" Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="5,2" Content="移除"
                                                        Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="资源要求">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,5"
                                    Command="{Binding AddResourceCommand}" Content="添加资源要求" />
                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsEnabled="{Binding CanEdit}" ItemsSource="{Binding ResourceRequirements}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="105" Header="类型">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.ResourceTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding ResourceType, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="120" Header="资源 ID" Binding="{Binding ResourceId, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="*" Header="能力 ID" Binding="{Binding CapabilityId, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="55" Header="数量" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridCheckBoxColumn Width="55" Header="互斥" Binding="{Binding Exclusive, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Width="52" Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="5,2" Content="移除"
                                                        Command="{Binding DataContext.RemoveResourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="执行流程">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="固定流程执行顺序" />
                                    <TextBlock Margin="0,3,0,0" Foreground="#667085" Text="只允许引用已发布、已验证的流程模板；方案发布后版本不可变。" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="AddWorkflowStepButton" DockPanel.Dock="Right" Padding="10,5"
                                        Command="{Binding AddWorkflowStepCommand}" Content="添加流程" />
                            </DockPanel>
                            <DataGrid x:Name="WorkflowStepGrid" Grid.Row="1" MinWidth="0"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                                      ItemsSource="{Binding WorkflowSteps}"
                                      SelectedItem="{Binding SelectedWorkflowStep, Mode=TwoWay}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="58" MinWidth="48" Header="顺序" Binding="{Binding Order}" IsReadOnly="True" />
                                    <DataGridTemplateColumn Width="2*" MinWidth="170" Header="流程模板">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox MinHeight="28"
                                                          ItemsSource="{Binding DataContext.PublishedWorkflowVersions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="Display"
                                                          SelectedItem="{Binding SelectedWorkflowVersion, Mode=TwoWay}"
                                                          IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="1.2*" MinWidth="110" Header="步骤名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="110" MinWidth="90" Header="预计时长(分)" Binding="{Binding EstimatedDurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="125" MinWidth="100" Header="参数覆盖" Binding="{Binding ParametersSummary}" />
                                    <DataGridTemplateColumn Width="58" MinWidth="52" Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="5,2" Content="移除"
                                                        Command="{Binding DataContext.RemoveWorkflowStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <WrapPanel>
                                    <Button x:Name="MoveWorkflowStepUpButton" Padding="10,4"
                                            Command="{Binding MoveWorkflowStepUpCommand}" Content="上移" />
                                    <Button x:Name="MoveWorkflowStepDownButton" Margin="6,0,0,0" Padding="10,4"
                                            Command="{Binding MoveWorkflowStepDownCommand}" Content="下移" />
                                </WrapPanel>
                                <TextBlock Margin="0,6,0,0" Foreground="#475467" TextWrapping="Wrap" Text="{Binding WorkflowStepsSummary}" />
                                <TextBlock Margin="0,8,0,3" Foreground="#667085" Text="选中步骤参数覆盖（key=value;...）" />
                                <TextBox MinHeight="30"
                                         Padding="6,4"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="仅覆盖当前方案步骤参数，不会修改已发布的流程模板。"
                                         Text="{Binding SelectedWorkflowStep.ParameterOverridesText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="#B42318"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedWorkflowStep.ParameterOverridesError}"
                                           Visibility="{Binding SelectedWorkflowStep.HasParameterOverridesError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,5" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" Text="完整度问题" />
                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" HorizontalAlignment="Right"
                           Foreground="#667085" Text="{Binding ValidationSummary}" />
            </DockPanel>
            <DataGrid x:Name="PlanValidationGrid" AutomationProperties.AutomationId="ExperimentPlanValidationGrid"
                      Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      ItemsSource="{Binding ValidationIssues}" SelectedItem="{Binding SelectedValidationIssue}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="60" Header="级别" Binding="{Binding Severity}" />
                    <DataGridTextColumn Width="210" Header="代码" Binding="{Binding Code}" />
                    <DataGridTextColumn Width="*" Header="问题" Binding="{Binding Message}" />
                    <DataGridTextColumn Width="130" Header="字段" Binding="{Binding Field}" />
                    <DataGridTextColumn Width="150" Header="资源" Binding="{Binding Resource}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="#475467" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="#B42318"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
