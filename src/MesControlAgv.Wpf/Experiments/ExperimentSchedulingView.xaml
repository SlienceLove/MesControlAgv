<UserControl x:Class="MesControlAgv.Wpf.Experiments.ExperimentSchedulingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             AutomationProperties.AutomationId="ExperimentSchedulingView"
             d:DesignHeight="760"
             d:DesignWidth="1380"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="265" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="任务排程" />
                <TextBlock Margin="0,3,0,0" Foreground="#667085" Text="{Binding BoardWindow}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#667085" Text="日期" />
                <DatePicker Width="132" SelectedDate="{Binding BoardDate}" />
                <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Foreground="#667085" Text="起始" />
                <ComboBox Width="58" ItemsSource="{Binding Hours}" SelectedItem="{Binding WindowStartHour}" />
                <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Foreground="#667085" Text="窗口" />
                <ComboBox Width="62" ItemsSource="{Binding WindowHourOptions}" SelectedItem="{Binding WindowHours}" />
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#667085" Text="小时" />
                <Button x:Name="SchedulingRefreshButton" AutomationProperties.AutomationId="ExperimentSchedulingRefreshButton"
                        Margin="12,0,0,0" Padding="14,7" Command="{Binding RefreshCommand}" Content="刷新窗口" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Margin="0,0,0,3" Foreground="#667085" Text="操作者" />
                <TextBox MinHeight="30" Padding="6,4" Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Margin="0,0,0,3" Foreground="#667085" Text="操作理由" />
                <TextBox MinHeight="30" Padding="6,4" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,3" Foreground="#667085" Text="数据状态" />
                <TextBlock MinHeight="30" Padding="6,5" Background="#F6F8FA" Text="{Binding RefreshStatus}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" MinHeight="250">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" Text="待排任务池" />
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" HorizontalAlignment="Right"
                               Foreground="#667085" Text="{Binding TaskPool.Count, StringFormat={}{0} 项}" />
                </DockPanel>
                <DataGrid x:Name="TaskPoolGrid" AutomationProperties.AutomationId="ExperimentTaskPoolGrid"
                          Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          ItemsSource="{Binding TaskPool}" SelectedItem="{Binding SelectedJob}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Header="样品批次" Binding="{Binding SampleBatchId}" />
                        <DataGridTextColumn Width="66" Header="优先级" Binding="{Binding PriorityText}" />
                        <DataGridTextColumn Width="72" Header="状态" Binding="{Binding Status}" />
                        <DataGridTextColumn Width="75" Header="计划" Binding="{Binding PlanName}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Expander x:Name="JobCreateExpander" AutomationProperties.AutomationId="ExperimentJobCreateExpander"
                          Grid.Row="2" Margin="0,8,0,0" Header="新建实验任务" MaxHeight="230">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="88" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,6,8,0" Text="已发布方案" />
                        <ComboBox Grid.Column="1" MinHeight="28" DisplayMemberPath="Display"
                                  ItemsSource="{Binding PublishedPlans}" SelectedItem="{Binding SelectedPublishedPlan}" />
                        <TextBlock Grid.Row="1" Margin="0,10,8,0" Text="样品批次" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" MinHeight="28" Padding="5,3"
                                 Text="{Binding SampleBatchId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Margin="0,10,8,0" Text="样品 ID" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" MinHeight="28" Padding="5,3"
                                 Text="{Binding SampleId, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGrid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6,0,0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" ItemsSource="{Binding JobParameters}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="110" Header="参数" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="*" Header="覆盖值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Width="50" Header="操作">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Padding="4,1" Content="移除"
                                                    Command="{Binding DataContext.RemoveJobParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,6,0,0" Orientation="Horizontal">
                            <Button Padding="9,4" Command="{Binding AddJobParameterCommand}" Content="添加参数" />
                            <Button x:Name="CreateJobButton" AutomationProperties.AutomationId="ExperimentCreateJobButton"
                                    Margin="6,0,0,0" Padding="9,4" Background="#1769AA" Foreground="White"
                                    Command="{Binding CreateJobCommand}" Content="创建任务" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#EAECF0" />

            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" Text="资源时间轴" />
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Border Width="12" Height="12" Margin="0,0,4,0" Background="#DCEBFF" BorderBrush="#1769AA" BorderThickness="1" />
                        <TextBlock Margin="0,0,12,0" Foreground="#667085" Text="计划预留" />
                        <Border Width="12" Height="12" Margin="0,0,4,0" Background="#FEE4E2" BorderBrush="#B42318" BorderThickness="1" />
                        <TextBlock Margin="0,0,12,0" Foreground="#667085" Text="阻塞" />
                        <Border Width="12" Height="12" Margin="0,0,4,0" Background="#FEF0C7" BorderBrush="#B54708" BorderThickness="1" />
                        <TextBlock Foreground="#667085" Text="活动运行租约" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer x:Name="ResourceTimeline" AutomationProperties.AutomationId="ExperimentResourceTimeline"
                              Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="1140">
                        <Grid Height="34" Width="1140">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="960" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="#D0D5DD" BorderThickness="0,0,1,1" />
                            <ItemsControl Grid.Column="1" Height="34" ItemsSource="{Binding TimelineTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="960" Height="34" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Border Width="1" Height="34" HorizontalAlignment="Left" Background="#D0D5DD" />
                                            <TextBlock Margin="4,0,0,0" FontSize="11" Foreground="#667085" Text="{Binding Label}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ResourceLanes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="1140" Height="{Binding Height}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="960" />
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="8,5" BorderBrush="#D0D5DD" BorderThickness="0,0,1,1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Margin="0,3,0,0" FontSize="11" Foreground="#667085"
                                                           Text="{Binding Load}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Column="1" Width="960" Height="{Binding Height}" ClipToBounds="True">
                                            <Border Background="#FAFBFC" BorderBrush="#EAECF0" BorderThickness="0,0,0,1" />
                                            <ItemsControl IsHitTestVisible="False"
                                                          ItemsSource="{Binding DataContext.TimelineTicks, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="960" Height="60" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="1" Height="60" Background="#EAECF0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Blocks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="960" Height="60" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button AutomationProperties.Name="{Binding Detail}"
                                                                Width="{Binding Width}" Height="{Binding Height}" Padding="4,1"
                                                                HorizontalContentAlignment="Left" Background="{Binding Fill}" BorderBrush="{Binding Border}"
                                                                Command="{Binding DataContext.SelectScheduleBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" ToolTip="{Binding Detail}">
                                                            <TextBlock FontSize="11" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="选中任务" />
                <Grid Grid.Row="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="#667085" Text="方案" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedPlan}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Foreground="#667085" Text="样品" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedJob.SampleBatchId}" />
                    <TextBlock Grid.Row="2" Foreground="#667085" Text="状态" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedJob.Status}" />
                    <TextBlock Grid.Row="3" Foreground="#667085" Text="计划时间" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedScheduleWindow}" />
                    <TextBlock Grid.Row="4" Foreground="#667085" Text="资源" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedResources}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <DataGrid x:Name="BlockingReasonGrid" AutomationProperties.AutomationId="ExperimentBlockingReasonGrid"
                          Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          ItemsSource="{Binding BlockingReasons}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="150" Header="阻塞代码" Binding="{Binding Code}" />
                        <DataGridTextColumn Width="*" Header="原因" Binding="{Binding Message}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#EAECF0" />

            <Grid Grid.Column="2" Margin="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="人工放置" />
                <Grid Grid.Row="1" Margin="0,6,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="#667085" Text="日期" />
                    <TextBlock Grid.Column="1" Foreground="#667085" Text="小时" />
                    <TextBlock Grid.Column="2" Foreground="#667085" Text="分钟" />
                    <TextBlock Grid.Column="3" Foreground="#667085" Text="时长(分)" />
                    <TextBlock Grid.Column="4" Foreground="#667085" Text="优先级" />
                    <DatePicker Grid.Row="1" Margin="0,3,6,0" SelectedDate="{Binding PlacementDate}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3,6,0" ItemsSource="{Binding Hours}" SelectedItem="{Binding PlacementStartHour}" />
                    <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,3,6,0" ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding PlacementStartMinute}" />
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,3,6,0" Padding="5,3" Text="{Binding DurationMinutes}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Margin="0,3,0,0" Padding="5,3" Text="{Binding Priority}" />
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Resources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="155" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" IsEnabled="{Binding Enabled}"
                                              Content="{Binding DisplayName}" />
                                    <TextBlock Grid.Column="1" Foreground="#667085" Text="{Binding Load}" />
                                    <TextBlock Grid.Column="2" Foreground="#667085" Text="{Binding State}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Margin="0,6,0,0" Orientation="Horizontal">
                    <Button x:Name="ScheduleButton" AutomationProperties.AutomationId="ExperimentScheduleButton"
                            Padding="12,6" Background="#1769AA" Foreground="White"
                            Command="{Binding ScheduleCommand}" Content="{Binding ScheduleButtonText}" />
                    <Button x:Name="UnscheduleButton" AutomationProperties.AutomationId="ExperimentUnscheduleButton"
                            Margin="6,0,0,0" Padding="12,6" Command="{Binding UnscheduleCommand}" Content="撤排" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#EAECF0" />

            <Grid Grid.Column="4" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="任务操作与审计" />
                <StackPanel Grid.Row="1" Margin="0,6,0,6" Orientation="Horizontal">
                    <Button x:Name="AdmitButton" AutomationProperties.AutomationId="ExperimentAdmitButton"
                            Padding="12,6" Background="#027A48" Foreground="White"
                            Command="{Binding AdmitCommand}" Content="运行准入" />
                    <Button x:Name="CancelJobButton" AutomationProperties.AutomationId="ExperimentCancelJobButton"
                            Margin="6,0,0,0" Padding="12,6" Command="{Binding CancelJobCommand}" Content="取消任务" />
                </StackPanel>
                <DataGrid x:Name="SchedulingAuditGrid" AutomationProperties.AutomationId="ExperimentSchedulingAuditGrid"
                          Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          ItemsSource="{Binding SelectedJobAudits}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="95" Header="时间" Binding="{Binding OccurredAt}" />
                        <DataGridTextColumn Width="*" Header="事件" Binding="{Binding EventType}" />
                        <DataGridTextColumn Width="85" Header="结果" Binding="{Binding Outcome}" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="3" Margin="0,6,0,0">
                    <TextBlock Foreground="#475467" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0" Foreground="#B42318" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
