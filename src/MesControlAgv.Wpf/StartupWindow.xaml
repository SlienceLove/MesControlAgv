<Window x:Class="MesControlAgv.Wpf.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AGV MES 中控"
        Width="420"
        Height="170"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="正在启动中控" />
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,14,0,10" Foreground="#52606D" Text="准备中..." TextWrapping="Wrap" />
        <ProgressBar Grid.Row="2" Height="6" IsIndeterminate="True" />
    </Grid>
</Window>
