<Window x:Class="MesControlAgv.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MesControlAgv.Wpf.Converters"
        xmlns:experiments="clr-namespace:MesControlAgv.Wpf.Experiments"
        xmlns:views="clr-namespace:MesControlAgv.Wpf.Views"
        xmlns:workflowCanvas="clr-namespace:MesControlAgv.Wpf.WorkflowCanvas"
        Title="中控运营中心"
        WindowState="Maximized"
        Width="1420"
        Height="860"
        MinWidth="820"
        MinHeight="480">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/MesTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StatusBrushConverter x:Key="StatusBrushConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
        <TabControl x:Name="MainTabs" Margin="0"
                    Style="{StaticResource MainNavigationTabControlStyle}"
                    ItemContainerStyle="{StaticResource MainNavigationTabItemStyle}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TabItem Header="任务监控" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <views:TaskMonitorView x:Name="TaskMonitorView" />
        </TabItem>
    <TabItem Header="KPI 看板" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <views:KpiDashboardView x:Name="KpiDashboardView" />
    </TabItem>
    <TabItem Header="离子色谱（已迁移至设备状态查询）" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="CIC-D160+" />
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" Text="离子色谱仪状态" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Width="38" Height="34" FontSize="20" Command="{Binding IonChromatography.RefreshCommand}" Content="↻" ToolTip="刷新仪器状态" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Margin="0,0,10,0" Padding="12" Background="#ECFDF3" BorderBrush="#C4EBD6" BorderThickness="1" CornerRadius="8">
                    <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding IonChromatography.ConnectionStatus, Converter={StaticResource StatusBrushConverter}}" /><TextBlock Foreground="#027A48" Text="连接" /></StackPanel><TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding IonChromatography.ConnectionStatus}" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="0,0,10,0" Padding="12" Background="#EEF5FF" BorderBrush="#CFE0FF" BorderThickness="1" CornerRadius="8">
                    <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding IonChromatography.DeviceState, Converter={StaticResource StatusBrushConverter}}" /><TextBlock Foreground="#175CD3" Text="设备状态" /></StackPanel><TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding IonChromatography.DeviceState}" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="0,0,10,0" Padding="12" Background="#FFF6ED" BorderBrush="#FEDFBE" BorderThickness="1" CornerRadius="8">
                    <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding IonChromatography.TaskAdmissionStatus, Converter={StaticResource StatusBrushConverter}}" /><TextBlock Foreground="#B54708" Text="任务准入" /></StackPanel><TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" Foreground="#A63A2B" Text="{Binding IonChromatography.TaskAdmissionStatus}" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="12" Background="#F2F4F7" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                    <StackPanel><TextBlock Foreground="#667085" Text="串口占用" /><TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding IonChromatography.PortStatus}" /></StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Padding="16" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="Gray" Text="电导率" />
                        <TextBlock Margin="0,6,0,0" FontSize="20" Text="{Binding IonChromatography.Conductivity}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="Gray" Text="总电导率" />
                        <TextBlock Margin="0,6,0,0" FontSize="20" Text="{Binding IonChromatography.TotalConductivity}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="Gray" Text="Pressure" />
                        <TextBlock Margin="0,6,0,0" FontSize="20" Text="{Binding IonChromatography.Pressure}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Foreground="Gray" Text="柱温" />
                        <TextBlock Margin="0,6,0,0" FontSize="20" Text="{Binding IonChromatography.ColumnTemperature}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Foreground="Gray" Text="流量" />
                        <TextBlock Margin="0,6,0,0" FontSize="20" Text="{Binding IonChromatography.Flow}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="设备识别" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Foreground="Gray" Text="仪器 ID" /><TextBlock Grid.Column="1" Text="{Binding IonChromatography.InstrumentId}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Foreground="Gray" Text="型号" /><TextBlock Grid.Column="1" Text="{Binding IonChromatography.Model}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Foreground="Gray" Text="观测标识" /><TextBlock Grid.Column="1" Text="{Binding IonChromatography.SerialNumber}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Foreground="Gray" Text="观测时间" /><TextBlock Grid.Column="1" Text="{Binding IonChromatography.ObservedAt}" />
                    </Grid>
                </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="执行策略" />
                    <TextBlock Margin="0,12,0,0" Foreground="Gray" Text="已开放操作" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding IonChromatography.EnabledOperations}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0" Foreground="Gray" Text="映射置信度" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding IonChromatography.MappingConfidence}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0" Foreground="Gray" Text="状态" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding IonChromatography.StatusMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" FontSize="11"
                               Foreground="{Binding IonChromatography.OfflineState.StateText, Converter={StaticResource StatusBrushConverter}}"
                               Text="{Binding IonChromatography.OfflineState.StateText, StringFormat=数据状态：{0}}" />
                </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </TabItem>
    <TabItem Header="设备状态查询" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <views:ShineLabDeviceStatusView DataContext="{Binding ShineLabDeviceStatus}" />
    </TabItem>
    <TabItem Header="ShineLab 任务下发（实验）" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <views:ShineLabTaskDispatchView DataContext="{Binding ShineLabTaskDispatch}" />
    </TabItem>
    <TabItem Header="离子色谱样品任务导入" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <views:ShineLabSequenceImportView x:Name="ShineLabSequenceImportView" />
    </TabItem>
    <TabItem x:Name="AgvCommunicationTab" Header="AGV 通讯与调度" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <views:AgvCommunicationView x:Name="AgvCommunicationView" />
    </TabItem>
    <TabItem x:Name="AuboArmTab" Header="AUBO 机械臂" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <views:AuboArmControlView DataContext="{Binding AuboArm}" />
    </TabItem>
    <TabItem Header="批量任务导入" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <views:BatchTaskImportView x:Name="BatchTaskImportView" />
    </TabItem>
    <TabItem AutomationProperties.AutomationId="WorkflowManagementTab" Header="实验流程管理" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <views:WorkflowManagementView x:Name="WorkflowManagementView" />
    </TabItem>
        <TabItem x:Name="ExperimentPlansTab" AutomationProperties.AutomationId="ExperimentPlansTab"
                 Header="实验方案"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch">
            <experiments:ExperimentPlanManagementView DataContext="{Binding ExperimentPlans}" />
        </TabItem>
        <TabItem x:Name="ExperimentSchedulingTab" AutomationProperties.AutomationId="ExperimentSchedulingTab"
                 Header="任务排程"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch">
            <experiments:ExperimentSchedulingView DataContext="{Binding ExperimentScheduling}" />
        </TabItem>
        <TabItem AutomationProperties.AutomationId="WorkflowRunMonitorTab"
                  Header="流程运行监控"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch">
            <workflowCanvas:WorkflowRunMonitorView DataContext="{Binding WorkflowRunMonitor}" />
        </TabItem>
        <TabItem x:Name="StartupDiagnosticsTab" Header="启动诊断"
                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <views:StartupDiagnosticsView x:Name="StartupDiagnosticsView" DataContext="{Binding Diagnostics}" />
        </TabItem>
        <TabItem Header="就绪 / 地图 / 审计" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="就绪 / 地图 / 审计" />
                        <TextBlock Margin="0,4,0,0" Foreground="Gray" Text="只读查看配置对比、预检门禁、实际路径和任务审计" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Padding="14,7" Command="{Binding Readiness.RefreshCommand}" Content="刷新就绪状态" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="地图与配置" />
                                    <TextBlock Margin="0,10,0,0" Foreground="Gray" Text="配置地图指纹" />
                                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding Readiness.ProfileFingerprint}" />
                                    <TextBlock Margin="0,10,0,0" Foreground="Gray" Text="控制器实时指纹" />
                                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding Readiness.LiveFingerprint}" />
                                    <TextBlock Margin="0,10,0,0" Foreground="Gray" Text="运行模式" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Readiness.OperatingMode}" />
                                     <TextBlock Margin="0,10,0,0" Foreground="Gray" Text="刷新状态" />
                                     <TextBlock Margin="0,3,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{Binding Readiness.Status}" />
                                     <TextBlock Margin="0,4,0,0" FontSize="11"
                                                Foreground="{Binding Readiness.OfflineState.StateText, Converter={StaticResource StatusBrushConverter}}"
                                                Text="{Binding Readiness.OfflineState.StateText, StringFormat=数据状态：{0}}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="预检门禁" />
                                    <TextBlock Margin="0,10,0,0" Foreground="Gray" Text="允许派发" />
                                    <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Readiness.DispatchPermitted}" />
                                    <TextBlock Margin="0,10,0,0" Foreground="Gray" Text="阻断原因" />
                                    <TextBlock Margin="0,3,0,0" Foreground="#B42318" TextWrapping="Wrap" Text="{Binding Readiness.BlockingReasons}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="已配置站点" />
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Readiness.MapSnapshot.Stations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Foreground="Gray" Text="{Binding Code}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AgvStationId}" />
                                                    <TextBlock Grid.Column="2" Foreground="Gray" Text="{Binding Enabled}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="有向地图边" />
                            <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Readiness.MapSnapshot.Edges}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*" Header="起点" Binding="{Binding From}" />
                                    <DataGridTextColumn Width="*" Header="终点" Binding="{Binding To}" />
                                    <DataGridTextColumn Width="90" Header="代价" Binding="{Binding Cost}" />
                                    <DataGridCheckBoxColumn Width="110" Header="双向" Binding="{Binding Bidirectional}" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="AGV 实际执行路径" />
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Readiness.FleetStatus}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="8" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Snapshot.AgvId}" />
                                                        <TextBlock Margin="0,3,0,0" Foreground="Gray" Text="{Binding Snapshot.CurrentStationId}" />
                                                        <TextBlock Margin="0,3,0,0" Text="{Binding ActiveTask.MesStatus}" />
                                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ActiveTask.Path}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Foreground="#315B87" Text="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{Binding Readiness.ActualExecutionPath}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="所选任务审计时间线" />
                                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding TaskEvents}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="8" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding EventType}" />
                                                            <TextBlock Margin="0,2,0,0" Foreground="Gray" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Payload}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="地图视图" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <views:MapDashboardView x:Name="MapDashboardView" />
        </TabItem>
    </TabControl>
</Window>
