<Window x:Class="MesControlAgv.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MesControlAgv.Wpf.Controls"
        Title="AGV MES 中控"
        Width="1420"
        Height="860"
        MinWidth="1180"
        MinHeight="720">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
        <TabControl Margin="20" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TabItem Header="任务监控" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
<Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="AGV MES 中控" />
                <TextBlock Margin="0,6,0,0" Foreground="Gray" Text="按当前站点与路线配置创建运输任务" />
            </StackPanel>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="MES 连接" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding ConnectionStatus}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="12,0,0,0" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="运行模式" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding RuntimeMode}" />
                    <TextBlock Foreground="Gray" FontSize="11" Text="{Binding RuntimeModeDescription}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="12,0,0,0" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="AGV 状态 / 当前位置" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding AgvStatus}" />
                    <TextBlock Text="{Binding AgvStation}" />
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Text="{Binding AgvExecutionStatus}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,16" Padding="14" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.ColumnSpan="6" FontSize="18" FontWeight="SemiBold" Text="新建运输任务" />

                <StackPanel Grid.Row="1" Margin="0,10,10,0">
                    <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="起点站" />
                    <ComboBox MinHeight="30" ItemsSource="{Binding AvailableStations}" SelectedItem="{Binding NewTaskSourceStation}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Margin="6,0,0,0" Foreground="Gray" Text="{Binding AgvStationId}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,10,0">
                    <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="终点站" />
                    <ComboBox MinHeight="30" ItemsSource="{Binding AvailableStations}" SelectedItem="{Binding NewTaskTargetStation}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Margin="6,0,0,0" Foreground="Gray" Text="{Binding AgvStationId}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,10,0">
                    <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="优先级" />
                    <TextBox MinHeight="30" Text="{Binding NewTaskPriority, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,10,10,0">
                    <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="外部单号" />
                    <TextBox MinHeight="30" Text="{Binding NewTaskExternalId, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,10,10,0">
                    <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="操作员" />
                    <TextBox MinHeight="30" Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="5" Margin="0,10,0,0">
                    <Button MinHeight="32" Command="{Binding PlanRouteCommand}" Content="预览路线" />
                    <Button Margin="0,8,0,0" MinHeight="38" Command="{Binding CreateTaskCommand}" Content="创建任务" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,10,0">
                    <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="任务描述" />
                    <TextBox MinHeight="30" Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,10,10,0">
                    <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="路线预览" />
                    <TextBlock MinHeight="30" VerticalAlignment="Center" Text="{Binding RoutePreview}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RoutePreview}" />
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" FontSize="11" Text="{Binding TaskFormStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" MinHeight="0" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="Gray" Text="Date:" />
                <DatePicker Width="140" SelectedDate="{Binding TaskFilterDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Margin="8,0,0,0" Padding="12,4" Command="{Binding QueryTasksCommand}" Content="Query" />
                <Button Margin="8,0,0,0" Padding="12,4" Command="{Binding RefreshTasksCommand}" Content="Refresh" />
            </StackPanel>
            <Grid Grid.Row="1" MinHeight="0" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" ItemsSource="{Binding Tasks}"
                      SelectedItem="{Binding SelectedTask}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="240" Header="任务 ID" Binding="{Binding Id}" />
                    <DataGridTextColumn Width="2*" Header="任务内容" Binding="{Binding TaskDescription}" />
                    <DataGridTextColumn Width="150" Header="起点站" Binding="{Binding SourceStationName}" />
                    <DataGridTextColumn Width="170" Header="终点站" Binding="{Binding TargetStationName}" />
                    <DataGridTextColumn Width="140" Header="状态" Binding="{Binding StatusDescription}" />
                    <DataGridTextColumn Width="145" Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                    <DataGridTextColumn Width="145" Header="Ended" Binding="{Binding EndedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                    <DataGridTextColumn Width="70" Header="重试" Binding="{Binding RetryCount}" />
                    <DataGridTextColumn Width="*" Header="错误" Binding="{Binding ErrorDescription}" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Column="1" Margin="16,0,0,0" MinHeight="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16" Background="#F6F8FA" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="所选任务操作" />
                        <Button Margin="0,16,0,0" MinHeight="36" Command="{Binding DispatchTaskCommand}" Content="派发任务" />
                        <Button Margin="0,16,0,0" MinHeight="32" Command="{Binding ArriveCommand}" Content="仿真到站并通知 MES" Visibility="{Binding IsManualArrivalAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,8,0,0" MinHeight="32" Command="{Binding ConfirmPickupCommand}" Content="确认取货" />
                        <Button Margin="0,8,0,0" MinHeight="32" Command="{Binding ConfirmDropoffCommand}" Content="确认放货" />
                        <Button Margin="0,8,0,0" MinHeight="32" Command="{Binding RetryCommand}" Content="失败后重试" />
                        <Button Margin="0,8,0,0" MinHeight="32" Command="{Binding RecoverCommand}" Content="恢复查询" />
                        <Button Margin="0,8,0,0" MinHeight="32" Command="{Binding CancelCommand}" Content="取消任务" />
                        <Separator Margin="0,16,0,12" />
                        <TextBlock FontWeight="SemiBold" Text="操作结果" />
                        <TextBlock Margin="0,4,0,0" Foreground="#176B3A" TextWrapping="Wrap" Text="{Binding ActionStatus}" />
                        <TextBlock Margin="0,6,0,0" Foreground="#8A6D1D" TextWrapping="Wrap" Text="{Binding OperatorValidationMessage}" />
                        <TextBlock Margin="0,4,0,0" Foreground="#B42318" TextWrapping="Wrap" Text="{Binding Message}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="任务详情" />
                        <StackPanel Grid.Row="1" Margin="0,8,0,8">
                            <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SelectedTask.TaskDescription}" />
                            <TextBlock Margin="0,6,0,0" Foreground="Gray" Text="{Binding SelectedTask.RouteDescription}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Foreground="Gray" Text="任务 ID" />
                                <TextBlock Text="{Binding SelectedTask.Id}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock Foreground="Gray" Text="状态：" />
                                <TextBlock Text="{Binding SelectedTask.StatusDescription}" />
                            </StackPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="Gray" Text="执行 AGV：" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTask.AssignedAgvDescription}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="Gray" Text="设备任务：" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTask.DeviceTaskDescription}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.DeviceTaskDescription}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="Gray" Text="当前路径：" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTask.CurrentPathDescription}" TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Margin="0,4,0,0" Foreground="#B42318" TextWrapping="Wrap" Text="{Binding SelectedTask.ErrorDescription}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TaskEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="8" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding EventType}" />
                                                <TextBlock Margin="0,2,0,0" Foreground="Gray" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Payload}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" Background="#FFF8E1" CornerRadius="6" Visibility="{Binding IsSimulatorPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="开发模拟器" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Margin="0,0,6,6" MinWidth="110" Command="{Binding SimulatorArriveCommand}" Content="底层到站" />
                             <Button Margin="0,0,6,6" MinWidth="90" Command="{Binding SimulatorFailCommand}" Content="下一次失败" />
                             <Button Margin="0,0,6,6" MinWidth="90" Command="{Binding SimulatorTimeoutCommand}" Content="下一次超时" />
                            <Button Margin="0,0,6,6" MinWidth="72" Command="{Binding SimulatorOfflineCommand}" Content="离线" />
                            <Button Margin="0,0,6,6" MinWidth="72" Command="{Binding SimulatorRecoverCommand}" Content="上线" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Foreground="Gray" Text="界面每 2 秒从 MES 刷新；取货与放货需要人工确认后才会推进。" />


        </Grid>
        </TabItem>
    <TabItem Header="KPI 看板" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="260" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,16">
                    <Border Margin="0,0,10,0" Padding="16" Background="#EAF2FF" CornerRadius="8"><StackPanel><TextBlock Foreground="#3867D6" Text="今日任务" /><TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="SemiBold" Text="{Binding Kpi.TaskSummary.Total}" /></StackPanel></Border>
                    <Border Margin="0,0,10,0" Padding="16" Background="#E8F7EF" CornerRadius="8"><StackPanel><TextBlock Foreground="#219653" Text="运行中" /><TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="SemiBold" Text="{Binding Kpi.TaskSummary.Running}" /></StackPanel></Border>
                    <Border Margin="0,0,10,0" Padding="16" Background="#EAF7F0" CornerRadius="8"><StackPanel><TextBlock Foreground="#219653" Text="已完成" /><TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="SemiBold" Text="{Binding Kpi.TaskSummary.Completed}" /></StackPanel></Border>
                    <Border Margin="0,0,10,0" Padding="16" Background="#FFF0F0" CornerRadius="8"><StackPanel><TextBlock Foreground="#D64545" Text="失败" /><TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="SemiBold" Text="{Binding Kpi.TaskSummary.Failed}" /></StackPanel></Border>
                    <Border Padding="16" Background="#FFF5E6" CornerRadius="8"><StackPanel><TextBlock Foreground="#B7791F" Text="完成率" /><TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="SemiBold" Text="{Binding Kpi.CompletionRate}" /></StackPanel></Border>
                </UniformGrid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Margin="0,0,16,0" Padding="12" Background="#F6F8FA" CornerRadius="8">
                        <Grid>
                            <controls:KpiDonutChart Slices="{Binding Kpi.StatusSlices}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Text="{Binding Kpi.TaskSummary.Total}" /><TextBlock Foreground="Gray" Text="任务状态" /></StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Padding="12" Background="#F6F8FA" CornerRadius="8">
                        <StackPanel>
                            <DockPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="任务趋势" /><TextBlock DockPanel.Dock="Right" Foreground="Gray" Text="创建 / 完成" /></DockPanel>
                            <controls:KpiTrendChart Height="205" Margin="0,8,0,0" Points="{Binding Kpi.TaskTrend}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Margin="0,0,8,0" Padding="16" Background="#F6F8FA" CornerRadius="8">
                        <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="样品处理信息" /><TextBlock Margin="0,10,0,0" Text="总量：{Binding Kpi.SampleSummary.Total}" /><TextBlock Margin="0,4,0,0" Text="待处理：{Binding Kpi.SampleSummary.Waiting}" /><TextBlock Margin="0,4,0,0" Text="处理中：{Binding Kpi.SampleSummary.Processing}" /><TextBlock Margin="0,4,0,0" Text="已完成：{Binding Kpi.SampleSummary.Completed}" /><TextBlock Margin="0,10,0,0" Foreground="DarkGoldenrod" TextWrapping="Wrap" Text="{Binding Kpi.SampleSummary.DataSource}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="16" Background="#F6F8FA" CornerRadius="8">
                        <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="耗材剩余情况" /><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Kpi.Consumables}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" /><ProgressBar Height="8" Margin="0,5,12,0" Maximum="{Binding Capacity}" Value="{Binding Remaining}" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Status}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="3" Margin="0,16,0,0" Padding="16" Background="#F6F8FA" CornerRadius="8">
                    <StackPanel><DockPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="仪器运作状态" /><TextBlock DockPanel.Dock="Right" Foreground="Gray" Text="{Binding Kpi.LastUpdated}" /></DockPanel><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Kpi.Instruments}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Status}" /><TextBlock Grid.Column="2" Foreground="Gray" TextWrapping="Wrap" Text="{Binding Detail}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </TabItem>
    <TabItem Header="AGV 通讯与调度" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="AGV 通讯与调度" />
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" Text="查看连接、在线状态、位置和当前任务；控制命令仅作用于当前任务" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Padding="14,7" Command="{Binding RefreshAgvCommand}" Content="刷新 AGV 状态" />
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <DataGrid Grid.Column="0" ItemsSource="{Binding Agvs}" SelectedItem="{Binding SelectedAgv}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="140" Header="AGV ID" Binding="{Binding AgvId}" />
                        <DataGridTextColumn Width="100" Header="连接状态" Binding="{Binding OnlineText}" />
                        <DataGridTextColumn Width="120" Header="控制权" Binding="{Binding ControlOwner}" />
                        <DataGridTextColumn Width="150" Header="当前位置" Binding="{Binding CurrentStationId}" />
                        <DataGridTextColumn Width="2*" Header="当前任务" Binding="{Binding CurrentTaskText}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Column="1" Margin="16,0,0,0" Padding="16" Background="#F6F8FA" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="调度控制" />
                        <TextBlock Margin="0,12,0,0" Foreground="Gray" Text="选中 AGV" />
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SelectedAgv.AgvId}" />
                        <TextBlock Margin="0,8,0,0" Foreground="Gray" Text="当前任务" />
                        <TextBlock Text="{Binding SelectedAgv.CurrentTaskText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Foreground="Gray" Text="{Binding SelectedAgv.CapabilitySummary}" TextWrapping="Wrap" />
                        <Button Margin="0,18,0,0" MinHeight="34" Command="{Binding PauseAgvCommand}" Content="暂停当前任务" />
                        <Button Margin="0,8,0,0" MinHeight="34" Command="{Binding ResumeAgvCommand}" Content="恢复当前任务" />
                        <Button Margin="0,8,0,0" MinHeight="34" Command="{Binding CancelAgvCommand}" Content="取消当前任务" />
                        <TextBlock Margin="0,18,0,0" Foreground="Gray" Text="说明：无当前任务时不会发送控制指令；真实 AGV 接入后由 Adapter 协议实现具体响应。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="Gray" Text="当前版本支持暂停、恢复、取消当前任务，以及查看 AGV 在线和连接状态。" />
        </Grid>
    </TabItem>
    <TabItem Header="批量任务导入" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="150" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="批量任务导入" />
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" Text="支持 CSV / XLSX；导入后按优先级、计划时间自动排序，可直接编辑优先级；站点支持数字编码、AGV 站点 ID 或名称" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="6,0,0,0" Padding="14,7" Click="ImportBatch_Click" Content="选择文件" />
                    <Button Margin="6,0,0,0" Padding="14,7" Command="{Binding SortBatchCommand}" Content="按优先级排序" />
                    <Button Margin="6,0,0,0" Padding="14,7" Background="#1769AA" Foreground="White" Command="{Binding SubmitBatchCommand}" Content="批量提交" />
                    <Button Margin="6,0,0,0" Padding="14,7" Command="{Binding ClearBatchCommand}" Content="清空" />
                </StackPanel>
            </DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding BatchTasks}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="70" Header="行号" Binding="{Binding SourceRowNumber}" IsReadOnly="True" />
                    <DataGridTextColumn Width="180" Header="任务 ID" Binding="{Binding TaskId}" IsReadOnly="True" />
                    <DataGridTextColumn Width="90" Header="起点" Binding="{Binding SourceStation}" IsReadOnly="True" />
                    <DataGridTextColumn Width="90" Header="终点" Binding="{Binding TargetStation}" IsReadOnly="True" />
                    <DataGridTextColumn Width="90" Header="优先级（可编辑）" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Width="180" Header="计划时间" Binding="{Binding PlannedTime}" IsReadOnly="True" />
                    <DataGridTextColumn Width="2*" Header="描述" Binding="{Binding Description}" IsReadOnly="True" />
                    <DataGridTextColumn Width="140" Header="状态" Binding="{Binding Status}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Padding="10" Background="#FFF8E1" BorderBrush="#E8C35A" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding BatchImportIssues}" />
                </ScrollViewer>
            </Border>
            <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="Gray" Text="{Binding BatchStatus}" />
        </Grid>
    </TabItem>    <TabItem Header="实验流程管理" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="实验流程管理" />
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" Text="可预设、编辑并通过拖拽编排实验步骤" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="6,0,0,0" Padding="14,7" Command="{Binding WorkflowEditor.NewWorkflowCommand}" Content="新建流程" />
                    <Button Margin="6,0,0,0" Padding="14,7" Command="{Binding WorkflowEditor.CopyWorkflowCommand}" Content="澶嶅埗" />
                    <Button Margin="6,0,0,0" Padding="14,7" Command="{Binding WorkflowEditor.DeleteWorkflowCommand}" Content="删除" />
                    <Button Margin="6,0,0,0" Padding="14,7" Background="#1769AA" Foreground="White" Command="{Binding WorkflowEditor.SaveCommand}" Content="保存" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" MinHeight="0" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="270" />
                </Grid.ColumnDefinitions>

                <Border Padding="12" Background="#F6F8FA" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="流程预设" />
                        <ListBox Grid.Row="1" Margin="0,8,0,16" ItemsSource="{Binding WorkflowEditor.Workflows}" SelectedItem="{Binding WorkflowEditor.SelectedWorkflow}" DisplayMemberPath="Name" />
                        <TextBlock Grid.Row="2" FontSize="16" FontWeight="SemiBold" Text="步骤工具箱" />
                        <ListBox x:Name="WorkflowPalette" Grid.Row="3" Margin="0,8,0,0" ItemsSource="{Binding WorkflowEditor.NodeTypeOptions}" DisplayMemberPath="DisplayName" PreviewMouseMove="WorkflowPalette_PreviewMouseMove">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Background" Value="White" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="12,0" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="12" Background="#F6F8FA">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding WorkflowEditor.SelectedWorkflow.Name}" />
                                 <TextBlock Margin="12,2,0,0" Foreground="Gray" Text="拖拽步骤到画布，节点可自由调整位置" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AllowDrop="True" DragOver="WorkflowCanvas_DragOver" Drop="WorkflowCanvas_Drop">
                            <Grid Width="1500" Height="720" Background="#FBFCFE">
                                <Canvas x:Name="WorkflowLinksCanvas" Width="1500" Height="720" IsHitTestVisible="False" />
                                <ItemsControl x:Name="WorkflowNodes" Width="1500" Height="720" ItemsSource="{Binding WorkflowEditor.Nodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="170" MinHeight="82" Padding="10" Background="#E8F1FF" BorderBrush="#4285C5" BorderThickness="1.5" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="WorkflowNode_MouseLeftButtonDown" MouseMove="WorkflowNode_MouseMove" MouseLeftButtonUp="WorkflowNode_MouseLeftButtonUp">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock FontSize="13" Foreground="#315B87" Text="{Binding TypeDescription}" />
                                                         <TextBlock DockPanel.Dock="Right" Foreground="#6B7280" Text="{Binding Order, StringFormat={}#{0}}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                                                    <TextBlock Margin="0,3,0,0" Foreground="#586174" FontSize="11" TextWrapping="Wrap" Text="{Binding TargetStation}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="12" Background="#F6F8FA" CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                             <TextBlock FontSize="16" FontWeight="SemiBold" Text="流程属性" />
                            <TextBlock Margin="0,12,0,4" Foreground="Gray" Text="流程名称" />
                            <TextBox Text="{Binding WorkflowEditor.SelectedWorkflow.Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="流程说明" />
                            <TextBox MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding WorkflowEditor.SelectedWorkflow.Description, UpdateSourceTrigger=PropertyChanged}" />
                            <Separator Margin="0,14" />
                             <TextBlock FontSize="16" FontWeight="SemiBold" Text="节点属性" />
                            <ListBox Margin="0,8,0,10" MaxHeight="120" ItemsSource="{Binding WorkflowEditor.Nodes}" SelectedItem="{Binding WorkflowEditor.SelectedNode}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Width="28" Foreground="Gray" Text="{Binding Order}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal">
                                <Button Padding="10,5" Command="{Binding WorkflowEditor.MoveNodeLeftCommand}" Content="宸︾Щ" />
                                <Button Margin="6,0,0,0" Padding="10,5" Command="{Binding WorkflowEditor.MoveNodeRightCommand}" Content="右移" />
                                <Button Margin="6,0,0,0" Padding="10,5" Command="{Binding WorkflowEditor.AddNodeCommand}" Content="添加" />
                                <Button Margin="6,0,0,0" Padding="10,5" Command="{Binding WorkflowEditor.DeleteNodeCommand}" Content="删除" />
                            </StackPanel>
                            <TextBlock Margin="0,12,0,4" Foreground="Gray" Text="节点类型" />
                            <ComboBox ItemsSource="{Binding WorkflowEditor.NodeTypeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding WorkflowEditor.SelectedNode.Type, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="鑺傜偣鍚嶇О" />
                            <TextBox Text="{Binding WorkflowEditor.SelectedNode.Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="鑺傜偣璇存槑" />
                            <TextBox MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding WorkflowEditor.SelectedNode.Description, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="鐩爣绔欑偣" />
                            <TextBox Text="{Binding WorkflowEditor.SelectedNode.TargetStation, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
             <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="Gray" Text="修改后点击保存，流程会持久化到本地 JSON 文件。" />
        </Grid>
    </TabItem>
    </TabControl>
</Window>
