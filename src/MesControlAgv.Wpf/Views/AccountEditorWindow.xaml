<Window x:Class="MesControlAgv.Wpf.Views.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号设置" Width="490" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F6FB">
    <StackPanel Margin="28">
        <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" Foreground="#123158"/>
        <TextBlock x:Name="Description" Margin="0,8,0,18" Foreground="#667085" TextWrapping="Wrap"/>
        <StackPanel x:Name="Form">
            <StackPanel x:Name="IdentityFields">
                <TextBlock Text="账号"/><TextBox x:Name="Username" Margin="0,5,0,12" Padding="8"/>
                <TextBlock Text="姓名"/><TextBox x:Name="DisplayName" Margin="0,5,0,12" Padding="8" MaxLength="64"/>
                <TextBlock Text="角色"/>
                <ComboBox x:Name="Role" Margin="0,5,0,12" Padding="8">
                    <ComboBoxItem Content="管理员" Tag="Administrator"/><ComboBoxItem Content="操作员" Tag="Operator"/><ComboBoxItem Content="只读用户" Tag="Viewer"/>
                </ComboBox>
                <CheckBox x:Name="Enabled" Content="启用账号" IsChecked="True" Margin="0,0,0,12"/>
            </StackPanel>
            <StackPanel x:Name="CurrentPasswordField"><TextBlock Text="当前密码"/><PasswordBox x:Name="CurrentPassword" Padding="8" Margin="0,5,0,12" MaxLength="128"/></StackPanel>
            <StackPanel x:Name="NewPasswordFields">
                <TextBlock Text="新密码"/><PasswordBox x:Name="NewPassword" Padding="8" Margin="0,5,0,12" MaxLength="128"/>
                <TextBlock Text="确认新密码"/><PasswordBox x:Name="ConfirmPassword" Padding="8" Margin="0,5,0,12" MaxLength="128"/>
                <TextBlock Text="10–128 位，至少包含字母和数字。" Foreground="#667085"/>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="Status" Margin="0,14,0,12" Foreground="#B42318" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" Padding="20,8" Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="保存" Padding="20,8" Click="Save_Click" Background="#1769AA" Foreground="White" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
