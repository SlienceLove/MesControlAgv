<UserControl x:Class="MesControlAgv.Wpf.Views.StartupDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MesControlAgv.Wpf.Converters"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <converters:StartupDiagnosticBrushConverter x:Key="StartupDiagnosticBrushConverter" />
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="启动与离线诊断" />
            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                       Text="本报告仅解析本地环境变量和配置文件，不连接 MES、Adapter、设备或现场端口。" />
            <TextBlock Margin="0,4,0,0" Foreground="Gray" FontSize="11"
                       Text="{Binding StartupConfiguration.DiagnosticRuleVersion, StringFormat=规则版本：{0}}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,14,0,14">
            <Border Width="180" Margin="0,0,10,8" Padding="12" Background="#F6F8FA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="检查结果" />
                    <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{Binding StartupConfiguration.OverallStatus, Converter={StaticResource StartupDiagnosticBrushConverter}}"
                               Text="{Binding StartupConfiguration.OverallStatus}" />
                </StackPanel>
            </Border>
            <Border Width="180" Margin="0,0,10,8" Padding="12" Background="#F6F8FA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="WPF 运行模式" />
                    <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding StartupConfiguration.RuntimeMode}" />
                </StackPanel>
            </Border>
            <Border Width="180" Margin="0,0,10,8" Padding="12" Background="#F6F8FA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="AGV 驱动" />
                    <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding StartupConfiguration.AdapterDriver}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Width="220" Margin="0,0,10,8" Padding="12" Background="#FFF6ED" BorderBrush="#FEDFBE" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="真实写入入口" />
                    <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{Binding StartupConfiguration.RealWriteAccess, Converter={StaticResource StartupDiagnosticBrushConverter}}"
                               Text="{Binding StartupConfiguration.RealWriteAccess}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="启动配置">
                <DataGrid x:Name="DiagnosticsGrid" MinWidth="0" ItemsSource="{Binding StartupConfiguration.Items}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="170" Header="检查项" Binding="{Binding Name}" />
                        <DataGridTemplateColumn Width="90" Header="结果">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{Binding SeverityText, Converter={StaticResource StartupDiagnosticBrushConverter}}"
                                               Text="{Binding SeverityText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="1.2*" Header="当前值" Binding="{Binding Value}" />
                        <DataGridTextColumn Width="2*" Header="说明" Binding="{Binding Detail}" />
                        <DataGridTextColumn Width="180" Header="代码" Binding="{Binding Code}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="离线审计">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Padding="12,5" Click="ImportDiagnostics_Click" Content="读取诊断" />
                            <Button Padding="12,5" Click="ExportDiagnostics_Click" Content="导出脱敏诊断" />
                            <Button Margin="8,0,0,0" Padding="12,5" Click="ClearAudit_Click" Content="清空审计" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Foreground="Gray" Text="{Binding LastExportStatus}" />
                    </DockPanel>
                    <DataGrid x:Name="AuditGrid" Grid.Row="1" MinWidth="0" ItemsSource="{Binding AuditEntries}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="150" Header="时间" Binding="{Binding OccurredAtText}" />
                            <DataGridTextColumn Width="150" Header="分类" Binding="{Binding Category}" />
                            <DataGridTextColumn Width="130" Header="动作" Binding="{Binding Action}" />
                            <DataGridTextColumn Width="130" Header="结果" Binding="{Binding Outcome}" />
                            <DataGridTextColumn Width="2*" Header="脱敏说明" Binding="{Binding Message}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem x:Name="FieldPreflightTab" Header="现场只读预检输入">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Text="{Binding FieldPreflightChecklist.DecisionText}" />
                        <TextBlock Margin="0,3,0,0" Foreground="#B54708" TextWrapping="Wrap"
                                   Text="{Binding FieldPreflightChecklist.SummaryText}" />
                    </StackPanel>
                    <DataGrid x:Name="FieldPreflightGrid" Grid.Row="1" MinWidth="0" ItemsSource="{Binding FieldPreflightChecklist.Items}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="180" Header="输入项" Binding="{Binding Name}" />
                            <DataGridTemplateColumn Width="110" Header="状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{Binding StatusText, Converter={StaticResource StartupDiagnosticBrushConverter}}"
                                                   Text="{Binding StatusText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="180" Header="离线值" Binding="{Binding Value}" />
                            <DataGridTextColumn Width="2*" Header="现场要求" Binding="{Binding Detail}" />
                            <DataGridTextColumn Width="180" Header="代码" Binding="{Binding Code}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem x:Name="ConfigurationDiffTab" Header="配置差异审阅">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Text="{Binding ConfigurationDiff.DecisionText}" />
                        <TextBlock Margin="0,3,0,0" Foreground="#B54708" TextWrapping="Wrap"
                                   Text="{Binding ConfigurationDiff.SummaryText}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,0,0,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="DiffCodeFilterBox" Width="170" MinHeight="28" Margin="0,0,8,0"
                                     AutomationProperties.AutomationId="OfflineDiagnosticDiffCodeFilter"
                                     ToolTip="按代码或名称筛选"
                                     Text="{Binding DiffCodeFilter, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox x:Name="DiffStatusFilterBox" Width="125" MinHeight="28" Margin="0,0,8,0"
                                      AutomationProperties.AutomationId="OfflineDiagnosticDiffStatusFilter"
                                      ItemsSource="{Binding DiffFilterOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedDiffFilter}" />
                            <TextBox x:Name="DiffReviewerBox" Width="120" MinHeight="28" Margin="0,0,8,0"
                                     AutomationProperties.AutomationId="OfflineDiagnosticDiffReviewer"
                                     ToolTip="审阅人（可填写简称）"
                                     Text="{Binding ReviewerLabel, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox x:Name="DiffReviewNoteBox" Width="220" MinHeight="28" Margin="0,0,8,0"
                                     AutomationProperties.AutomationId="OfflineDiagnosticDiffReviewNote"
                                     ToolTip="审阅备注（不会修改快照）"
                                     Text="{Binding DiffReviewNote, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="RecordDiffReviewButton" Padding="12,5" Click="RecordDiffReview_Click"
                                    AutomationProperties.AutomationId="RecordOfflineDiagnosticDiffReview"
                                    Content="记录本次审阅"
                                    IsEnabled="{Binding ConfigurationDiff.HasBaseline}" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Margin="0,0,0,8" Foreground="Gray" FontSize="11"
                               HorizontalAlignment="Left" Text="{Binding FilteredDiffSummary}" />
                    <DataGrid x:Name="ConfigurationDiffGrid" Grid.Row="3" MinWidth="0" ItemsSource="{Binding FilteredConfigurationDiffItems}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="190" Header="检查项" Binding="{Binding Name}" />
                            <DataGridTemplateColumn Width="95" Header="差异">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{Binding KindText, Converter={StaticResource StartupDiagnosticBrushConverter}}"
                                                   Text="{Binding KindText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="1.2*" Header="基线值" Binding="{Binding BaselineValue}" />
                            <DataGridTextColumn Width="1.2*" Header="当前值" Binding="{Binding CurrentValue}" />
                            <DataGridTextColumn Width="150" Header="基线状态" Binding="{Binding BaselineStatus}" />
                            <DataGridTextColumn Width="150" Header="当前状态" Binding="{Binding CurrentStatus}" />
                            <DataGridTextColumn Width="2*" Header="说明" Binding="{Binding Detail}" />
                            <DataGridTextColumn Width="180" Header="代码" Binding="{Binding Code}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem x:Name="SnapshotLifecycleTab" Header="快照生命周期">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Text="离线诊断快照保留与清理预览" />
                        <TextBlock Margin="0,3,0,0" Foreground="#B54708" TextWrapping="Wrap"
                                   Text="{Binding SnapshotInventory.SummaryText}" />
                        <TextBlock Margin="0,3,0,0" Foreground="Gray" FontSize="11"
                                   Text="{Binding SnapshotInventory.BoundaryText}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,0,0,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="SnapshotDirectoryBox" Width="380" MinHeight="28" Margin="0,0,8,0"
                                     AutomationProperties.AutomationId="OfflineDiagnosticSnapshotDirectory"
                                     ToolTip="只扫描该目录下的 mes-offline-diagnostics*.json"
                                     Text="{Binding SnapshotDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="ScanSnapshotButton" Padding="12,5" Click="ScanSnapshotLifecycle_Click"
                                    AutomationProperties.AutomationId="ScanOfflineDiagnosticSnapshots"
                                    Content="扫描目录" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="2" Margin="0,0,0,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="CleanupConfirmationCheckBox" Margin="0,0,10,0" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="ConfirmOfflineDiagnosticCleanup"
                                      Content="确认仅移动候选到可恢复回收目录"
                                      IsChecked="{Binding CleanupConfirmationChecked}" />
                            <TextBox x:Name="CleanupConfirmationPhraseBox" Width="290" MinHeight="28" Margin="0,0,8,0"
                                     AutomationProperties.AutomationId="OfflineDiagnosticCleanupConfirmationPhrase"
                                     ToolTip="{Binding CleanupConfirmationHint, Mode=OneWay}"
                                     Text="{Binding CleanupConfirmationPhrase, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="MoveSnapshotCandidatesButton" Padding="12,5" Click="MoveSnapshotCandidates_Click"
                                    AutomationProperties.AutomationId="MoveOfflineDiagnosticCandidates"
                                    Content="移动到回收目录"
                                    IsEnabled="{Binding CanMoveSnapshotCandidates}" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="3" Margin="0,0,0,8" Foreground="Gray" FontSize="11">
                        <Run Text="策略：" />
                        <Run Text="{Binding SnapshotRetentionPolicy.Description, Mode=OneWay}" />
                        <Run Text="；确认短语：" />
                        <Run Text="{Binding CleanupConfirmationHint, Mode=OneWay}" />
                    </TextBlock>
                    <DataGrid x:Name="SnapshotLifecycleGrid" Grid.Row="4" MinWidth="0" ItemsSource="{Binding SnapshotInventory.Items}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="260" Header="文件" Binding="{Binding FileName}" />
                            <DataGridTemplateColumn Width="100" Header="格式">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{Binding ValidationStatusText, Converter={StaticResource StartupDiagnosticBrushConverter}}"
                                                   Text="{Binding ValidationStatusText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="160" Header="最后写入" Binding="{Binding LastWriteAtText}" />
                            <DataGridTextColumn Width="100" Header="大小" Binding="{Binding SizeText}" />
                            <DataGridTemplateColumn Width="150" Header="保留状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{Binding RetentionStatusText, Converter={StaticResource StartupDiagnosticBrushConverter}}"
                                                   Text="{Binding RetentionStatusText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="2*" Header="清理说明" Binding="{Binding CleanupReason}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem x:Name="SnapshotRestoreTab" Header="回收目录恢复">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Text="回收快照恢复预览" />
                        <TextBlock Margin="0,3,0,0" Foreground="#B54708" TextWrapping="Wrap"
                                   Text="{Binding QuarantineInventory.SummaryText}" />
                        <TextBlock Margin="0,3,0,0" Foreground="Gray" FontSize="11"
                                   Text="只恢复 manifest 一致且目标不存在的文件；不会覆盖、上传或后台恢复。" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
                        <Button x:Name="ScanSnapshotQuarantineButton" Padding="12,5" Click="ScanSnapshotQuarantine_Click"
                                AutomationProperties.AutomationId="ScanOfflineDiagnosticQuarantine"
                                Content="扫描回收目录" />
                        <CheckBox x:Name="RestoreConfirmationCheckBox" Margin="12,0,10,0" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="ConfirmOfflineDiagnosticRestore"
                                  Content="确认恢复可恢复文件"
                                  IsChecked="{Binding RestoreConfirmationChecked}" />
                        <TextBox x:Name="RestoreConfirmationPhraseBox" Width="320" MinHeight="28" Margin="0,0,8,0"
                                 AutomationProperties.AutomationId="OfflineDiagnosticRestoreConfirmationPhrase"
                                 ToolTip="{Binding RestoreConfirmationHint, Mode=OneWay}"
                                 Text="{Binding RestoreConfirmationPhrase, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="RestoreSnapshotCandidatesButton" Padding="12,5" Click="RestoreSnapshotCandidates_Click"
                                AutomationProperties.AutomationId="RestoreOfflineDiagnosticCandidates"
                                Content="恢复快照"
                                IsEnabled="{Binding CanRestoreSnapshotCandidates}" />
                    </StackPanel>
                    <DataGrid x:Name="SnapshotQuarantineGrid" Grid.Row="2" MinWidth="0" ItemsSource="{Binding QuarantineInventory.Items}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="220" Header="回收批次" Binding="{Binding BatchDirectoryName}" />
                            <DataGridTextColumn Width="110" Header="manifest" Binding="{Binding ValidationStatusText}" />
                            <DataGridTextColumn Width="130" Header="移动时间" Binding="{Binding MovedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                            <DataGridTextColumn Width="110" Header="可恢复数" Binding="{Binding RestorableFileCount}" />
                            <DataGridTextColumn Width="2*" Header="校验说明" Binding="{Binding ValidationMessage}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
