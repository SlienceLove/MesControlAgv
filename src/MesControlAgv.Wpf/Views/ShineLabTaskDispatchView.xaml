<UserControl x:Class="MesControlAgv.Wpf.Views.ShineLabTaskDispatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="ShineLab 任务下发（实验）" />
            <TextBlock Margin="0,4,0,0" Foreground="Gray"
                       Text="中控通过 MES TCP Server 向常驻 ShineLab Client 发送 Config/Command，不直接访问串口" />
        </StackPanel>
        <Grid x:Name="DispatchWorkspaceGrid" Grid.Row="1" MinWidth="0"
              SizeChanged="DispatchWorkspaceGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="0" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="0" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DispatchFormPanel" Grid.Row="0" Grid.Column="0" Padding="16" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="任务与样品" />
                        <TextBlock Margin="0,12,0,4" Foreground="Gray" Text="设备编码" />
                        <TextBox MinHeight="30" Text="{Binding EquipmentCode, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="任务号" />
                        <TextBox MinHeight="30" Text="{Binding TaskUuid, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="样品编号" />
                        <TextBox MinHeight="30" Text="{Binding SampleId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="样品名称" />
                        <TextBox MinHeight="30" Text="{Binding SampleName, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="样品类型" />
                                <TextBox MinHeight="30" Text="{Binding SampleType, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="位置" />
                                <TextBox MinHeight="30" Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="盘位 mPos" />
                                <TextBox MinHeight="30" Text="{Binding MPos, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="通道 A/B" />
                                <TextBox MinHeight="30" Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="进样方法" />
                        <TextBox MinHeight="30" Text="{Binding InstrumentMethod, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="结果处理方法" />
                        <TextBox MinHeight="30" Text="{Binding ProcessingMethod, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="检测方式" />
                        <TextBox MinHeight="30" Text="{Binding DetectionMethod, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,10,0,4" Foreground="Gray" Text="进样体积（uL）" />
                        <TextBox MinHeight="30" Text="{Binding InjectionVolume, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="0,16,0,0" MinHeight="38" Command="{Binding SendConfigCommand}" Content="发送 Config" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="DispatchCommandPanel" Grid.Row="0" Grid.Column="2" Padding="16" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <ScrollViewer x:Name="DispatchCommandScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="控制命令" />
                    <TextBlock Margin="0,12,0,4" Foreground="Gray" Text="Action（按 ShineLab 协议）" />
                    <TextBox MinHeight="30" Text="{Binding Action, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray"
                               Text="协议示例：0 启动取样，1 停止，2 启动检测；最终以 ShineLab 确认的 SHA18i 映射为准。" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,4" Foreground="Gray" Text="清洗时间（可选）" />
                    <TextBox MinHeight="30" Text="{Binding CleanTime, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="0,16,0,0" MinHeight="38" Command="{Binding SendCommandCommand}" Content="发送 Command" />
                    <Separator Margin="0,18,0,12" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="最近响应" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding LastResponseText}" />
                    <TextBlock Margin="0,12,0,0" Foreground="#176B3A" TextWrapping="Wrap" Text="{Binding Message}" />
                    <Button Margin="0,16,0,0" MinHeight="34" Command="{Binding RefreshTasksCommand}" Content="刷新任务记录" />
                    <DataGrid x:Name="DispatchTaskGrid" Height="240" Margin="0,10,0,0" MinWidth="0"
                              ItemsSource="{Binding Tasks}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="170" Header="任务号" Binding="{Binding TaskUuid}" />
                            <DataGridTextColumn Width="100" Header="状态" Binding="{Binding Status}" />
                            <DataGridTextColumn Width="120" Header="阶段" Binding="{Binding CurrentStage}" />
                            <DataGridTextColumn Width="*" Header="错误" Binding="{Binding LastError}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,14,0,0" Foreground="#A63A2B" FontSize="11" TextWrapping="Wrap"
                               Text="实验阶段仅用于接口联调；真正执行前必须由 ShineLab 提供并确认 Action、方法字段和设备互锁规则。" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
