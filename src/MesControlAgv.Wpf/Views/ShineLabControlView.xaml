<UserControl x:Class="MesControlAgv.Wpf.Views.ShineLabControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="View_Loaded">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Width="115" Height="34" Content="刷新状态和任务" Command="{Binding RefreshCommand}"/>
            <StackPanel>
                <TextBlock x:Name="PageHeading" Text="离子色谱样品任务" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OperatorConnectionSummary}" Foreground="#475569" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <TabControl x:Name="SectionTabs" Grid.Row="1">
            <TabItem x:Name="DeviceTab" Header="通讯与托盘" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="托盘操作" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TrayAvailability}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,16,0,12">
                            <Button Content="托盘弹出" Command="{Binding TrayPopupCommand}" Padding="22,9" Margin="0,0,12,0"/>
                            <Button Content="托盘复位" Command="{Binding TrayResetCommand}" Padding="22,9"/>
                        </WrapPanel>
                        <TextBlock Text="操作需单独确认；仪器接受操作后，请现场确认托盘到位。"
                                   Foreground="#92400E" TextWrapping="Wrap"/>
                        <TextBlock Text="最近操作应答" FontWeight="SemiBold" Margin="0,22,0,8"/>
                        <TextBox Text="{Binding OperatorReply, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="65"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ImportTab" Header="样品导入与预检" IsSelected="True">
                <Grid x:Name="ImportLayout" Margin="14" SizeChanged="ImportLayout_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <WrapPanel>
                            <Button Content="导入 CSV / XLSX" Click="Import_Click" IsEnabled="{Binding IsInteractive}" Padding="14,6"/>
                            <TextBlock Text="{Binding SourceFile}" Margin="12,7,0,0" TextWrapping="Wrap"/>
                        </WrapPanel>
                        <TextBlock Margin="0,8,0,0" Foreground="#92400E" TextWrapping="Wrap"
                                   Text="当前支持未知样品、单次进样。请在 AQ 核对色谱方法、处理方法和体积，并保存设置。"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ImportedSamples}" SelectedItem="{Binding SelectedImport}"
                              IsEnabled="{Binding IsInteractive}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="源编号" Binding="{Binding SampleId}" Width="*"/>
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="*"/>
                            <DataGridTextColumn Header="位置" Binding="{Binding Position}" Width="65"/>
                            <DataGridTextColumn Header="色谱方法（需AQ核对）" Binding="{Binding InstrumentMethod}" Width="*"/>
                            <DataGridTextColumn Header="处理方法（需AQ核对）" Binding="{Binding ProcessingMethod}" Width="2*"/>
                            <DataGridTextColumn Header="体积" Binding="{Binding InjectionVolume}" Width="70"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding InjectionVolumeUnit}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,12">
                        <WrapPanel>
                            <Button Content="1. 核对选中样品" Command="{Binding PrepareCommand}" Padding="12,6" Margin="0,0,12,0"/>
                            <Button Content="2. 下发选中样品" Command="{Binding SendConfigCommand}" Padding="12,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding OperatorPreparedSummary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer x:Name="ImportDetails" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <TextBlock Text="选中样品" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedImport.SampleName}" Margin="0,8,0,8" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedImport.MPos, StringFormat=进样位置：{0}}" Margin="0,0,0,8"/>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="解析问题" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding ImportIssues}"><ItemsControl.ItemTemplate><DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#B91C1C" Margin="0,5,0,0"/>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="下发后请在 AQ 核对目标序列和新增样品。只勾选本次要运行的样品，并保存修改。本页不会自动启动实验。"
                                       TextWrapping="Wrap" Foreground="#92400E" Margin="0,12,0,0"/>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="ResultsTab" Header="样品与检测结果">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                    <DataGrid x:Name="OperatorTaskGrid" ItemsSource="{Binding TaskItems}" SelectedItem="{Binding SelectedTaskItem}"
                              IsEnabled="{Binding IsInteractive}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MinHeight="130">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleNames}" Width="2*"/>
                            <DataGridTextColumn Header="样品编号" Binding="{Binding SourceNumbers}" Width="1.3*"/>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedTime}" Width="100"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*"/>
                            <DataGridTextColumn Header="检测结果" Binding="{Binding ResultState}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="1" Margin="0,10,0,10">
                        <Button DockPanel.Dock="Right" Content="查看结果" Height="34" VerticalAlignment="Top" Command="{Binding LoadDetailCommand}" Padding="14,6"/>
                        <TextBlock Text="{Binding OperatorTaskSummary}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <Grid Grid.Row="2">
                     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                     <Border Background="#FFF8E8" BorderBrush="#E2B04A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                      <StackPanel>
                       <TextBlock Text="{Binding ResultReviewSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                       <Expander Header="排查建议">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                         <ItemsControl ItemsSource="{Binding OperatorResultReviews}"><ItemsControl.ItemTemplate><DataTemplate>
                          <StackPanel Margin="0,8,0,0">
                           <TextBlock Text="{Binding Compound}" FontWeight="SemiBold"/>
                           <TextBlock Text="{Binding Observation}" TextWrapping="Wrap"/>
                           <TextBlock Text="{Binding Suggestions}" Foreground="#92400E" TextWrapping="Wrap"/>
                          </StackPanel>
                         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </ScrollViewer>
                       </Expander>
                      </StackPanel>
                     </Border>
                     <DataGrid x:Name="OperatorResultGrid" Grid.Row="1" ItemsSource="{Binding Compounds}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                      <DataGrid.Columns>
                       <DataGridTextColumn Header="组分" Binding="{Binding Name}" Width="1.5*"/>
                       <DataGridTextColumn Header="保留时间/min" Binding="{Binding RetentionTime}" Width="*"/>
                       <DataGridTextColumn Header="峰面积" Binding="{Binding Area}" Width="*"/>
                       <DataGridTextColumn Header="浓度" Binding="{Binding Concentration}" Width="*"/>
                       <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80"/>
                      </DataGrid.Columns>
                     </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding OperatorMessage}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#334155"/>
    </Grid>
</UserControl>
