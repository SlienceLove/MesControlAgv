<Window x:Class="MesControlAgv.Wpf.Views.AddConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加连接"
        Width="550"
        Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F8FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="选择目标节点" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- 节点列表 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="NodeListBox"
                     ItemsSource="{Binding AvailableNodes}"
                     SelectedItem="{Binding TargetNode}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,12" Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding Title}"
                                          FontWeight="SemiBold" FontSize="14"
                                          TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Text="{Binding Type}"
                                          Foreground="#666" FontSize="11"
                                          Margin="0,4,0,0" />

                                <TextBlock Grid.Row="2" Text="{Binding Description}"
                                          Foreground="#999" FontSize="10"
                                          Margin="0,4,0,0"
                                          TextWrapping="Wrap"
                                          MaxHeight="40"
                                          TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F3F5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E8F0FE" />
                                <Setter Property="BorderBrush" Value="#4285F4" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- 条件输入 -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="连接条件（可选）" Foreground="#666" FontSize="11" Margin="0,0,0,6" />
            <TextBox x:Name="ConditionTextBox"
                     Padding="10"
                     BorderBrush="#D0D7DE"
                     Background="White"
                     FontSize="12"
                     Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="例如：成功、失败、条件A等" Foreground="#999" FontSize="10" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消"
                    Click="Cancel_Click"
                    Padding="24,10"
                    Margin="0,0,12,0"
                    Background="White"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    FontSize="13"
                    Cursor="Hand" />
            <Button Content="确定"
                    Click="OK_Click"
                    Padding="24,10"
                    Background="#4285F4"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
