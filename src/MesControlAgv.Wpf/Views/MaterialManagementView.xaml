<UserControl x:Class="MesControlAgv.Wpf.Views.MaterialManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="物料管理" />
                <TextBlock Margin="0,4,0,0" Foreground="Gray"
                           Text="样品、耗材库存、扫码与溯源；仓储字段集中在本模块维护。" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,10,0" Foreground="Gray"
                           Text="{Binding OfflineState.StateText}" />
                <Button Padding="12,6" Command="{Binding RefreshCommand}" Content="刷新" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="MaterialTabs">
            <TabItem Header="样品">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock VerticalAlignment="Center" Text="导入类型" />
                        <ComboBox Width="90" Margin="8,0,12,0"
                                  ItemsSource="{Binding ImportModes}"
                                  SelectedItem="{Binding ImportMode, Mode=TwoWay}" />
                        <Button Padding="12,6" Click="ChooseImportFile_Click" Content="选择 CSV / XLSX" />
                        <Button Margin="8,0,0,0" Padding="12,6"
                                Command="{Binding PreviewImportCommand}" Content="预览校验" />
                        <Button Margin="8,0,0,0" Padding="12,6" Background="#1769AA" Foreground="White"
                                Command="{Binding CommitImportCommand}" Content="提交导入" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                                   Text="{Binding ImportStatus}" TextTrimming="CharacterEllipsis" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Samples}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" x:Name="SamplesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="样品条码" Binding="{Binding Barcode}" Width="1.5*" />
                            <DataGridTextColumn Header="样品批次" Binding="{Binding SampleBatchId}" Width="1.2*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding SampleType}" Width="*" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="库位" Binding="{Binding Location.LocationCode}" Width="*" />
                            <DataGridTextColumn Header="绑定任务" Binding="{Binding BoundExperimentJobId}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="8" Background="#FFF8E1"
                            BorderBrush="#E8C35A" BorderThickness="1" CornerRadius="4">
                        <ItemsControl ItemsSource="{Binding ImportIssues}" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="耗材库存">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBox Width="130" Margin="0,0,8,0" Text="{Binding InventoryMaterialCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="物料编码" />
                        <TextBox Width="130" Margin="0,0,8,0" Text="{Binding InventoryLotCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="批号" />
                        <TextBox Width="110" Margin="0,0,8,0" Text="{Binding InventoryLocationCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="库位" />
                        <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" IsChecked="{Binding IncludeQuarantined}" Content="包含隔离" />
                        <Button Padding="12,6" Command="{Binding RefreshCommand}" Content="查询库存" />
                    </WrapPanel>
                    <Border Grid.Row="1" Margin="0,0,0,10" Padding="8" Background="#F6F8FA"
                            BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4">
                        <WrapPanel>
                            <TextBlock VerticalAlignment="Center" Text="快速入库" />
                            <TextBox Width="110" Margin="10,0,6,0" Text="{Binding ReceiveMaterialCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="物料编码" />
                            <TextBox Width="120" Margin="0,0,6,0" Text="{Binding ReceiveMaterialName, UpdateSourceTrigger=PropertyChanged}" ToolTip="物料名称" />
                            <TextBox Width="110" Margin="0,0,6,0" Text="{Binding ReceiveLotCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="批号" />
                            <TextBox Width="70" Margin="0,0,6,0" Text="{Binding ReceiveQuantity, UpdateSourceTrigger=PropertyChanged}" ToolTip="数量" />
                            <TextBox Width="60" Margin="0,0,6,0" Text="{Binding ReceiveUnit, UpdateSourceTrigger=PropertyChanged}" ToolTip="单位" />
                            <TextBox Width="90" Margin="0,0,8,0" Text="{Binding ReceiveLocationCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="库位" />
                            <Button Padding="12,6" Command="{Binding ReceiveCommand}" Content="入库" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" Text="{Binding ActionStatus}" />
                        </WrapPanel>
                    </Border>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Inventory}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" x:Name="InventoryGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="物料编码" Binding="{Binding MaterialCode}" Width="1.2*" />
                            <DataGridTextColumn Header="名称" Binding="{Binding MaterialName}" Width="1.2*" />
                            <DataGridTextColumn Header="批号" Binding="{Binding LotCode}" Width="1.2*" />
                            <DataGridTextColumn Header="库位" Binding="{Binding Location.LocationCode}" Width="*" />
                            <DataGridTextColumn Header="在库" Binding="{Binding OnHand}" Width="*" />
                            <DataGridTextColumn Header="预占" Binding="{Binding Reserved}" Width="*" />
                            <DataGridTextColumn Header="可用" Binding="{Binding Available}" Width="*" />
                            <DataGridTextColumn Header="有效期" Binding="{Binding ExpiryDate}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="扫码与追溯">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBox Width="260" Margin="0,0,8,0" Text="{Binding ScanCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="扫描枪或手工输入条码" />
                        <Button Padding="12,6" Command="{Binding ScanCommand}" Content="解析条码" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ScanStatus}" />
                    </WrapPanel>
                    <Border Grid.Row="1" Margin="0,0,0,10" Padding="8" Background="#F6F8FA"
                            BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4">
                        <WrapPanel>
                            <TextBlock VerticalAlignment="Center" Text="溯源查询" />
                            <TextBox Width="260" Margin="10,0,8,0" Text="{Binding TraceQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="条码 / 物料编码 / 批号" />
                            <Button Padding="12,6" Command="{Binding QueryTraceCommand}" Content="查询" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" Text="{Binding TraceStatus}" />
                        </WrapPanel>
                    </Border>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding TraceEvents}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" x:Name="TraceGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding OccurredAt}" Width="1.4*" />
                            <DataGridTextColumn Header="事件" Binding="{Binding EventType}" Width="1.2*" />
                            <DataGridTextColumn Header="条码" Binding="{Binding Barcode}" Width="1.3*" />
                            <DataGridTextColumn Header="物料 / 批号" Binding="{Binding MaterialCode}" Width="1.3*" />
                            <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="*" />
                            <DataGridTextColumn Header="任务" Binding="{Binding ExperimentJobId}" Width="1.5*" />
                            <DataGridTextColumn Header="操作人" Binding="{Binding Actor}" Width="*" />
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
