<Window x:Class="MesControlAgv.Wpf.Views.WorkstationTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开盖分液 · 任务模板与批量导入" Width="1200" Height="740" MinWidth="850" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F3F6FB">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="任务模板与批量导入" FontSize="24" FontWeight="SemiBold" Foreground="#123158"/>
            <TextBlock Text="同一任务编号多行，每行一条分液明细。先预览校验，再明确导入；导入不启动设备。" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="1">
            <TabItem Header="单任务模板">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="任务编号" VerticalAlignment="Center"/><TextBox x:Name="TaskNo" Width="200" Margin="8,0,18,0"/>
                        <TextBlock Text="任务名称" VerticalAlignment="Center"/><TextBox x:Name="TaskName" Width="220" Margin="8,0,18,0"/>
                        <Button Content="新编号" Click="NewNumber_Click" Padding="12,6"/>
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Margin="0,10">
                        <WrapPanel>
                            <TextBlock Text="设备已有任务" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <ComboBox x:Name="SourceTasks" Width="310" IsEditable="True" IsTextSearchEnabled="True"
                                      DisplayMemberPath="Label" TextSearch.TextPath="TaskNo" Margin="0,0,8,6"
                                      ToolTip="加载后选择任务，或直接输入设备中的任务编号"/>
                            <Button x:Name="LoadTasks" Content="加载任务" Click="LoadTasks_Click" Padding="12,6" Margin="0,0,8,6"/>
                            <Button x:Name="MoreTasks" Content="加载更多" Click="MoreTasks_Click" Padding="12,6" Margin="0,0,8,6" Visibility="Collapsed"/>
                            <Button x:Name="CopySource" Content="复制为新模板" Click="ReadSource_Click" Padding="12,6" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <TextBlock x:Name="TaskListStatus" Text="来源：开盖分液设备。可直接输入任务编号，或点击加载任务。" Foreground="#5C7084" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <WrapPanel>
                        <Button x:Name="FillReference" Content="填入参考示例" Click="FillReference_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="打开本地模板" Click="OpenTemplate_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="增加明细" Click="AddRow_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="删除选中明细" Click="RemoveRow_Click" Padding="12,6"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="TransferGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="溶剂编码" Binding="{Binding LiquidCode}" Width="110"/>
                            <DataGridTextColumn Header="枪头模块" Binding="{Binding TipModule}" Width="110"/>
                            <DataGridTextColumn Header="枪头X" Binding="{Binding TipX}" Width="70"/>
                            <DataGridTextColumn Header="枪头Y" Binding="{Binding TipY}" Width="70"/>
                            <DataGridTextColumn Header="来源模块" Binding="{Binding SourceModule}" Width="110"/>
                            <DataGridTextColumn Header="来源X" Binding="{Binding SourceX}" Width="70"/>
                            <DataGridTextColumn Header="来源Y" Binding="{Binding SourceY}" Width="70"/>
                            <DataGridTextColumn Header="目标模块" Binding="{Binding TargetModule}" Width="110"/>
                            <DataGridTextColumn Header="目标X" Binding="{Binding TargetX}" Width="70"/>
                            <DataGridTextColumn Header="目标Y" Binding="{Binding TargetY}" Width="70"/>
                            <DataGridTextColumn Header="体积 µL" Binding="{Binding Volume}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="模块编码使用设备实际值；“示例_”编码须替换后才能导入。来源/目标坐标和体积为正整数；枪头 0/0 使用工作站默认值。" TextWrapping="Wrap" Foreground="#5C7084"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="保存模板 / 导出 Excel 样表" Click="SaveTemplate_Click" Padding="14,8" Background="#1769AA" Foreground="White"/>
                            <Button x:Name="PreviewSingle" Content="校验并转入导入预览" Click="PreviewSingle_Click" Padding="14,8" Margin="10,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="批量导入任务">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button x:Name="ChooseExcel" Content="选择 Excel 并校验" Click="ChooseExcel_Click" Padding="14,8"/>
                        <TextBlock x:Name="Summary" Margin="14,0,0,0" VerticalAlignment="Center" Text="请先在单任务页保存模板，再复制明细行填写不同任务编号。" TextWrapping="Wrap"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Margin="0,10" Text="每批最多 100 个任务、5000 条明细、4 MiB；任务编号保持文本格式。同编号名称须一致，不覆盖已有任务。" TextWrapping="Wrap" Foreground="#5C7084"/>
                    <DataGrid x:Name="PreviewGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="PreviewSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="任务编号" Binding="{Binding TaskNo}" Width="200"/>
                            <DataGridTextColumn Header="任务名称" Binding="{Binding TaskName}" Width="*"/>
                            <DataGridTextColumn Header="分液明细" Binding="{Binding Transfers.Count}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="PreviewDetails" Grid.Row="3" Margin="0,8,0,0" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="溶剂" Binding="{Binding LiquidCode}" Width="*"/>
                            <DataGridTextColumn Header="枪头模块" Binding="{Binding TipModule}" Width="*"/>
                            <DataGridTextColumn Header="枪头X" Binding="{Binding TipX}" Width="65"/>
                            <DataGridTextColumn Header="枪头Y" Binding="{Binding TipY}" Width="65"/>
                            <DataGridTextColumn Header="来源模块" Binding="{Binding SourceModule}" Width="*"/>
                            <DataGridTextColumn Header="来源X" Binding="{Binding SourceX}" Width="65"/>
                            <DataGridTextColumn Header="来源Y" Binding="{Binding SourceY}" Width="65"/>
                            <DataGridTextColumn Header="目标模块" Binding="{Binding TargetModule}" Width="*"/>
                            <DataGridTextColumn Header="目标X" Binding="{Binding TargetX}" Width="65"/>
                            <DataGridTextColumn Header="目标Y" Binding="{Binding TargetY}" Width="65"/>
                            <DataGridTextColumn Header="体积 µL" Binding="{Binding VolumeMicroliters}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <WrapPanel><TextBlock Text="操作人" VerticalAlignment="Center"/><TextBox x:Name="Actor" Width="180" Margin="8,0,18,0"/>
                            <Button x:Name="ImportButton" Content="确认导入（不启动）" Click="Import_Click" Padding="14,8" IsEnabled="False" Background="#1769AA" Foreground="White"/>
                            <Button Content="导出导入结果" Click="ExportResults_Click" Padding="14,8" Margin="10,0,0,0"/>
                        </WrapPanel>
                        <TextBox x:Name="ImportResult" Margin="0,10,0,0" Height="80" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="Status" Text="模板仅保存在本地；读取来源模板是只读操作。" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#244665"/>
    </Grid>
</Window>
