<Window x:Class="MesControlAgv.Wpf.Views.CreateConsumableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增耗材" Width="680" Height="550" MinWidth="540" MinHeight="470"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="新增耗材" />
        <ScrollViewer Grid.Row="1" Margin="0,16,0,10" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Margin="0,0,0,5" Text="物料编码 *" />
                    <TextBox MinHeight="32" Text="{Binding MaterialCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Margin="0,0,0,5" Text="耗材名称 *" />
                    <TextBox MinHeight="32" Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Margin="0,0,0,5" Text="批号 *" />
                    <TextBox MinHeight="32" Text="{Binding LotCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Margin="0,0,0,5" Text="批次条码" />
                    <TextBox MinHeight="32" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Margin="0,0,0,5" Text="数量 *" />
                    <TextBox MinHeight="32" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Margin="0,0,0,5" Text="单位" />
                    <TextBox MinHeight="32" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Margin="0,0,0,5" Text="规格" />
                    <TextBox MinHeight="32" Text="{Binding Specification, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Margin="0,0,0,5" Text="库位 *" />
                    <TextBox MinHeight="32" Text="{Binding LocationCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Margin="0,0,0,5" Text="生产日期" />
                    <DatePicker SelectedDate="{Binding ManufactureDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2">
                    <TextBlock Margin="0,0,0,5" Text="失效日期" />
                    <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Padding="12,6" Margin="0,0,8,0" Click="Close_Click" Content="关闭" />
                <Button Padding="14,6" Background="#1769AA" Foreground="White"
                        Command="{Binding SaveCommand}" Content="确认入库" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap"
                       Text="{Binding Status}" />
        </DockPanel>
    </Grid>
</Window>
