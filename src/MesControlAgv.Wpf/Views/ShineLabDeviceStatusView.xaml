<UserControl x:Class="MesControlAgv.Wpf.Views.ShineLabDeviceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MesControlAgv.Wpf.Converters"
             xmlns:views="clr-namespace:MesControlAgv.Wpf.Views">
    <UserControl.Resources>
        <converters:InstrumentVisibilityConverter x:Key="InstrumentVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding InstrumentTitle}" />
            </StackPanel>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0" Padding="12,6" Content="单任务模板" Click="SingleTaskTemplate_Click"
                        Visibility="{Binding IsSampleWorkstationSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Margin="0,0,8,0" Padding="12,6" Content="批量导入任务" Click="BatchTaskImport_Click"
                        Visibility="{Binding IsSampleWorkstationSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Width="100" Height="34" Command="{Binding RefreshCommand}" Content="刷新状态"
                        Visibility="{Binding IsSampleWorkstationSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </WrapPanel>
        </DockPanel>

        <!-- The two items are peer instruments.  The opening/dispensing page
             is not derived from or filtered out of the ShineLab list. -->
        <TabControl Grid.Row="1" Margin="0,0,0,6"
                    ItemsSource="{Binding InstrumentOptions}"
                    SelectedItem="{Binding SelectedInstrument, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Padding="18,5" FontSize="16" FontWeight="SemiBold" Text="{Binding}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Border Height="0"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- MES-owned sample records only; not an AQ sequence snapshot. -->
        <Grid x:Name="DeviceSummaryGrid" Grid.Row="2" Margin="0,0,0,8"
              Visibility="{Binding SelectedInstrument, Converter={StaticResource InstrumentVisibilityConverter}, ConverterParameter=离子色谱}"
              MinWidth="0">
            <Grid DataContext="{Binding ControlModel, RelativeSource={RelativeSource AncestorType={x:Type views:ShineLabDeviceStatusView}}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel x:Name="IonOnlineToolbar" Margin="0,0,0,12">
                    <Border Background="#F1F5F9" CornerRadius="5" Padding="12,7" Margin="0,0,10,0">
                        <TextBlock Text="{Binding DataContext.IonOperatorOnline, RelativeSource={RelativeSource AncestorType={x:Type views:ShineLabDeviceStatusView}}}" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="刷新样品记录" Click="RefreshIonRecordsOnLoad" Padding="12,6" Margin="0,0,10,0"/>
                    <Button Content="托盘弹出" Command="{Binding TrayPopupCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="托盘复位" Command="{Binding TrayResetCommand}" Padding="12,6"/>
                </WrapPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock x:Name="IonCurrentTaskText" Margin="0,0,0,4" Foreground="#175CD3"
                               Text="{Binding DataContext.IonCurrentTaskSummary, RelativeSource={RelativeSource AncestorType={x:Type views:ShineLabDeviceStatusView}}, StringFormat=当前任务：{0}}"
                               ToolTip="{Binding DataContext.IonCurrentTaskSummary, RelativeSource={RelativeSource AncestorType={x:Type views:ShineLabDeviceStatusView}}}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="中控样品记录" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="仅显示中控记录，不代表 AQ 的完整序列；AQ 中手动添加或修改的样品不在此同步。"
                               Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <DataGrid x:Name="IonTasksGrid" ItemsSource="{Binding TaskItems}"
                              SelectedItem="{Binding SelectedTaskItem}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleNames}" Width="2*" MinWidth="100"/>
                            <DataGridTextColumn Header="样品编号" Binding="{Binding SourceNumbers}" Width="1.3*" MinWidth="90"/>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedTime}" Width="100"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*" MinWidth="80"/>
                            <DataGridTextColumn Header="检测结果" Binding="{Binding ResultState}" Width="*" MinWidth="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="暂无中控样品记录" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding TaskItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Text="{Binding OperatorReply}" TextWrapping="Wrap"/>
                    <TextBlock Text="样品导入、下发及检测结果详情请进入“仪器任务导入”。" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- The task grid owns the available height and scrolls independently. -->
        <Grid x:Name="WorkstationWorkspace" Grid.Row="2" Margin="0,0,0,8"
              Visibility="{Binding SelectedInstrument, Converter={StaticResource InstrumentVisibilityConverter}, ConverterParameter=开盖分液}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WrapPanel x:Name="WorkstationOnlineToolbar" Margin="0,0,0,6">
                <Border Background="#F1F5F9" CornerRadius="5" Padding="12,7" Margin="0,0,12,0">
                    <TextBlock x:Name="WorkstationOnlineText" Text="{Binding WorkstationOperatorOnline}" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="当前库任务" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding WorkstationTaskCount, StringFormat=已读取 {0} 条}" Foreground="#64748B"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </WrapPanel>
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="WorkstationCurrentTaskText" Margin="0,0,0,4" Foreground="#175CD3"
                           Text="{Binding WorkstationCurrentTaskSummary, StringFormat=当前任务：{0}}"
                           ToolTip="{Binding WorkstationCurrentTaskSummary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="WorkstationNotice" Text="{Binding WorkstationOperatorNotice}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkstationOperatorNotice}"
                       Foreground="#9A6700" Margin="0,0,0,8"
                       Visibility="{Binding HasWorkstationOperatorNotice, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <Grid Grid.Row="2">
                <DataGrid x:Name="WorkstationTasksGrid" ItemsSource="{Binding WorkstationTasks}"
                          SelectedItem="{Binding SelectedWorkstationTask, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" HeadersVisibility="Column" MinHeight="60"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="1.2*" MinWidth="100" Header="任务编号" Binding="{Binding TaskNo}"/>
                        <DataGridTextColumn Width="1.5*" MinWidth="120" Header="任务名称" Binding="{Binding TaskName}"/>
                        <DataGridTextColumn Width="0.8*" MinWidth="70" Header="状态" Binding="{Binding State}"/>
                        <DataGridTextColumn Width="1.2*" MinWidth="110" Header="生成时间" Binding="{Binding MakeTime}"/>
                        <DataGridTextColumn Width="1.5*" MinWidth="100" Header="备注" Binding="{Binding Remark}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="WorkstationEmptyText" Text="暂无可展示任务，请刷新或使用顶部模板入口。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#64748B" IsHitTestVisible="False" TextWrapping="Wrap" Margin="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WorkstationTasks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Border x:Name="WorkstationTestPanel" Grid.Row="3" Margin="0,8,0,0" Padding="10"
                    Background="#FFF8E8" BorderBrush="#E2B04A" BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding IsWorkstationTestControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer MaxHeight="54" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="联调测试 · 正式运行由实验工作流统一调度" Foreground="#7A3E00" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="WorkstationTestStartButton" Padding="12,6" Margin="0,0,12,0"
                                    Command="{Binding StartWorkstationTestTaskCommand}" Content="启动测试任务"/>
                            <TextBlock Text="选中任务：" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedWorkstationTaskNo}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding SelectedWorkstationTaskState}" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding WorkstationTestControlMessage}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
