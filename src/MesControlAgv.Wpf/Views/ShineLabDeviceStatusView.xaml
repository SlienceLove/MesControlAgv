<UserControl x:Class="MesControlAgv.Wpf.Views.ShineLabDeviceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MesControlAgv.Wpf.Converters">
    <UserControl.Resources>
        <converters:InstrumentVisibilityConverter x:Key="InstrumentVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding InstrumentTitle}" />
                <TextBlock Margin="0,4,0,0" Foreground="Gray"
                           Text="{Binding InstrumentDescription}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Width="100" Height="34"
                    Command="{Binding RefreshCommand}" Content="刷新状态" />
        </DockPanel>

        <!-- The two items are peer instruments.  The opening/dispensing page
             is not derived from or filtered out of the ShineLab list. -->
        <TabControl Grid.Row="1" Margin="0,0,0,14"
                    ItemsSource="{Binding InstrumentOptions}"
                    SelectedItem="{Binding SelectedInstrument, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Padding="18,8" FontSize="16" FontWeight="SemiBold" Text="{Binding}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <TextBlock Margin="12,4" Foreground="Gray"
                               Text="选择上方大设备后查看对应的只读状态" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- Ion chromatography: only the ShineLab sub-device status list is
             shown here (for example D160+ and automatic sampler 18i). -->
        <Grid x:Name="DeviceSummaryGrid" Grid.Row="2" Margin="0,0,0,14"
              Visibility="{Binding SelectedInstrument, Converter={StaticResource InstrumentVisibilityConverter}, ConverterParameter=离子色谱}"
              MinWidth="0" SizeChanged="DeviceSummaryGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="0" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="0" />
                <ColumnDefinition Width="3*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="DeviceListHost" Grid.Row="0" Grid.Column="0" Margin="0,0,12,0"
                    Padding="12" Background="#F6F8FA" BorderBrush="#D0D7DE"
                    BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="离子色谱子设备" />
                    <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="Gray"
                               Text="仅展示在线、运行等状态，不显示任务映射信息。" />
                    <DataGrid Margin="0,10,0,0" ItemsSource="{Binding VisibleIonSubdevices}"
                              SelectedItem="{Binding SelectedSubdevice, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              MinWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="1.5*" MinWidth="110" Header="子设备"
                                                Binding="{Binding DeviceName}" />
                            <DataGridTextColumn Width="1*" MinWidth="90" Header="设备编号"
                                                Binding="{Binding EquipmentCode}" />
                            <DataGridTextColumn Width="0.8*" MinWidth="60" Header="在线"
                                                Binding="{Binding OnlineText}" />
                            <DataGridTextColumn Width="0.9*" MinWidth="70" Header="状态"
                                                Binding="{Binding StateText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="Gray"
                               TextWrapping="Wrap" Text="{Binding Message}" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="SelectedDeviceScrollViewer" Grid.Row="0" Grid.Column="1"
                          Margin="0" MinWidth="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Padding="16" Background="White" BorderBrush="#D0D7DE"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="4" FontSize="18" FontWeight="SemiBold"
                                   Text="子设备状态" />
                        <TextBlock Grid.Row="1" Margin="0,14,8,0" Foreground="Gray" Text="设备" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,14,8,0"
                                   Text="{Binding SelectedDeviceName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,14,8,0" Foreground="Gray" Text="设备编号" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,14,0,0"
                                   Text="{Binding SelectedEquipmentCode}" />
                        <TextBlock Grid.Row="2" Margin="0,8,8,0" Foreground="Gray" Text="在线状态" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,8,0"
                                   FontWeight="SemiBold" Text="{Binding SelectedOnline}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="运行状态" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,8,0,0"
                                   Text="{Binding SelectedStateDisplay}" />
                        <TextBlock Grid.Row="3" Margin="0,8,8,0" Foreground="Gray" Text="最后观测" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                   Text="{Binding SelectedLastSeen}" />
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="4" Margin="0,16,0,0"
                                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                   Text="离子色谱下的 D160+、自动进样器 18i 等子设备均通过 MES 只读状态接口展示。" />
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Opening/dispensing workstation: an independent layout and data
             source.  No ion-chromatography card is rendered in this branch. -->
        <ScrollViewer Grid.Row="2" Margin="0,0,0,14"
                      Visibility="{Binding SelectedInstrument, Converter={StaticResource InstrumentVisibilityConverter}, ConverterParameter=开盖分液}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Padding="16" Background="#F6F8FA" BorderBrush="#D0D7DE"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="4" FontSize="18" FontWeight="SemiBold"
                                   Text="开盖分液工作站状态" />
                        <TextBlock Grid.Row="1" Margin="0,14,8,0" Foreground="Gray" Text="工作站 ID" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,14,8,0"
                                   Text="{Binding SampleWorkstationDeviceId}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,14,8,0" Foreground="Gray" Text="接口" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,14,0,0"
                                   Text="{Binding WorkstationConnectionStatus}" />
                        <TextBlock Grid.Row="2" Margin="0,8,8,0" Foreground="Gray" Text="在线状态" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,8,0"
                                   FontWeight="SemiBold" Text="{Binding WorkstationOnline}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="仪器状态" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,8,0,0"
                                   Text="{Binding WorkstationState}" />
                        <TextBlock Grid.Row="3" Margin="0,8,8,0" Foreground="Gray" Text="原始状态码" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,8,0"
                                   Text="{Binding WorkstationRawState}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="观测时间" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,8,0,0"
                                   Text="{Binding WorkstationObservedAt}" />
                        <TextBlock Grid.Row="4" Margin="0,8,8,0" Foreground="Gray" Text="错误信息" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Text="{Binding WorkstationError}" />
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="4" Margin="0,16,0,0"
                                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                   Text="{Binding WorkstationAvailabilityMessage}" />
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0" Padding="16" Background="White"
                        BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="最近任务" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Foreground="Gray" Text="任务编号" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkstationLatestTaskNo}" />
                            <TextBlock Grid.Column="2" Foreground="Gray" Text="任务状态" />
                            <TextBlock Grid.Column="3" Text="{Binding WorkstationLatestTaskState}" />
                            <TextBlock Grid.Row="1" Margin="0,8,8,0" Foreground="Gray" Text="任务名称" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,8,0"
                                       Text="{Binding WorkstationLatestTaskName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="生成时间" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"
                                       Text="{Binding WorkstationLatestTaskTime}" />
                        </Grid>
                        <DataGrid Margin="0,14,0,0" ItemsSource="{Binding WorkstationTasks}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" MinHeight="80"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="1.2*" MinWidth="100" Header="任务编号" Binding="{Binding TaskNo}" />
                                <DataGridTextColumn Width="1.5*" MinWidth="120" Header="任务名称" Binding="{Binding TaskName}" />
                                <DataGridTextColumn Width="0.8*" MinWidth="70" Header="状态" Binding="{Binding State}" />
                                <DataGridTextColumn Width="1.2*" MinWidth="110" Header="生成时间" Binding="{Binding MakeTime}" />
                                <DataGridTextColumn Width="1.5*" MinWidth="100" Header="备注" Binding="{Binding Remark}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
