<UserControl x:Class="MesControlAgv.Wpf.Views.ShineLabDeviceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="离子色谱设备状态" />
                <TextBlock Margin="0,4,0,0" Foreground="Gray"
                           Text="仅显示 ShineLab 推送的设备和任务状态，中控不直接连接串口" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Width="100" Height="34"
                    Command="{Binding RefreshCommand}" Content="刷新状态" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,12,0" Padding="12" Background="#F6F8FA"
                    BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="已发现设备" />
                    <ListBox Margin="0,8,0,0" ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DeviceName}" />
                                        <TextBlock FontSize="11" Foreground="Gray" Text="{Binding EquipmentCode}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding State}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="Gray"
                               TextWrapping="Wrap" Text="{Binding Message}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="16" Background="White"
                    BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="4" FontSize="18" FontWeight="SemiBold" Text="所选设备" />
                    <TextBlock Grid.Row="1" Margin="0,14,8,0" Foreground="Gray" Text="设备" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,14,8,0" Text="{Binding SelectedDeviceName}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,14,8,0" Foreground="Gray" Text="连接" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,14,0,0" FontWeight="SemiBold" Text="{Binding SelectedOnline}" />
                    <TextBlock Grid.Row="2" Margin="0,8,8,0" Foreground="Gray" Text="设备状态" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,8,0" Text="{Binding SelectedState}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="任务" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,8,0,0" Text="{Binding SelectedTaskState}" />
                    <TextBlock Grid.Row="3" Margin="0,8,8,0" Foreground="Gray" Text="当前样品" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,8,0" Text="{Binding SelectedSample}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="通道/位置" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,8,0,0" Text="{Binding SelectedChannelPosition}" />
                    <TextBlock Grid.Row="4" Margin="0,8,8,0" Foreground="Gray" Text="阶段/进度" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,8,0" Text="{Binding SelectedStage}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="报警" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Margin="0,8,0,0" Text="{Binding SelectedAlarm}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="12" Background="White"
                BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="推送明细" />
                <DataGrid Margin="0,12,0,0" ItemsSource="{Binding Devices}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="180" Header="设备" Binding="{Binding DeviceName}" />
                        <DataGridTextColumn Width="110" Header="在线" Binding="{Binding Online}" />
                        <DataGridTextColumn Width="120" Header="状态" Binding="{Binding State}" />
                        <DataGridTextColumn Width="150" Header="任务状态" Binding="{Binding HasActiveTask}" />
                        <DataGridTextColumn Width="200" Header="任务号" Binding="{Binding TaskUuid}" />
                        <DataGridTextColumn Width="160" Header="样品" Binding="{Binding SampleName}" />
                        <DataGridTextColumn Width="100" Header="通道" Binding="{Binding Channel}" />
                        <DataGridTextColumn Width="100" Header="位置" Binding="{Binding Position}" />
                        <DataGridTextColumn Width="180" Header="最后推送" Binding="{Binding LastSeenAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
