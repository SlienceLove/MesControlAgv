<UserControl x:Class="MesControlAgv.Wpf.Views.ShineLabDeviceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MesControlAgv.Wpf.Converters"
             xmlns:views="clr-namespace:MesControlAgv.Wpf.Views">
    <UserControl.Resources>
        <converters:InstrumentVisibilityConverter x:Key="InstrumentVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding InstrumentTitle}" />
                <TextBlock Margin="0,4,0,0" Foreground="Gray"
                           Visibility="{Binding SelectedInstrument, Converter={StaticResource InstrumentVisibilityConverter}, ConverterParameter=开盖分液}"
                           Text="{Binding InstrumentDescription}" />
            </StackPanel>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0" Padding="12,6" Content="单任务模板" Click="SingleTaskTemplate_Click"
                        Visibility="{Binding IsSampleWorkstationSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Margin="0,0,8,0" Padding="12,6" Content="批量导入任务" Click="BatchTaskImport_Click"
                        Visibility="{Binding IsSampleWorkstationSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Width="100" Height="34" Command="{Binding RefreshCommand}" Content="刷新状态"
                        Visibility="{Binding IsSampleWorkstationSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </WrapPanel>
        </DockPanel>

        <!-- The two items are peer instruments.  The opening/dispensing page
             is not derived from or filtered out of the ShineLab list. -->
        <TabControl Grid.Row="1" Margin="0,0,0,14"
                    ItemsSource="{Binding InstrumentOptions}"
                    SelectedItem="{Binding SelectedInstrument, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Padding="18,8" FontSize="16" FontWeight="SemiBold" Text="{Binding}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <TextBlock Margin="12,4" Foreground="Gray"
                               Visibility="{Binding Converter={StaticResource InstrumentVisibilityConverter}, ConverterParameter=开盖分液}"
                               Text="选择上方大设备后查看对应的只读状态" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- MES-owned sample records only; not an AQ sequence snapshot. -->
        <Grid x:Name="DeviceSummaryGrid" Grid.Row="2" Margin="0,0,0,8"
              Visibility="{Binding SelectedInstrument, Converter={StaticResource InstrumentVisibilityConverter}, ConverterParameter=离子色谱}"
              MinWidth="0">
            <Grid DataContext="{Binding ControlModel, RelativeSource={RelativeSource AncestorType={x:Type views:ShineLabDeviceStatusView}}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel x:Name="IonOnlineToolbar" Margin="0,0,0,12">
                    <Border Background="#F1F5F9" CornerRadius="5" Padding="12,7" Margin="0,0,10,0">
                        <TextBlock Text="{Binding OperatorOnlineText}" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="刷新样品记录" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,10,0"/>
                    <Button Content="托盘弹出" Command="{Binding TrayPopupCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="托盘复位" Command="{Binding TrayResetCommand}" Padding="12,6"/>
                </WrapPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="中控样品记录" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="仅显示中控记录，不代表 AQ 的完整序列；AQ 中手动添加或修改的样品不在此同步。"
                               Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <DataGrid x:Name="IonTasksGrid" ItemsSource="{Binding TaskItems}"
                              SelectedItem="{Binding SelectedTaskItem}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleNames}" Width="2*" MinWidth="100"/>
                            <DataGridTextColumn Header="样品编号" Binding="{Binding SourceNumbers}" Width="1.3*" MinWidth="90"/>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedTime}" Width="100"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*" MinWidth="80"/>
                            <DataGridTextColumn Header="检测结果" Binding="{Binding ResultState}" Width="*" MinWidth="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="暂无中控样品记录" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding TaskItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Text="{Binding OperatorReply}" TextWrapping="Wrap"/>
                    <TextBlock Text="样品导入、下发及检测结果详情请进入“仪器任务导入”。" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Opening/dispensing workstation: an independent layout and data
             source.  No ion-chromatography card is rendered in this branch. -->
        <ScrollViewer Grid.Row="2" Margin="0,0,0,14"
                      Visibility="{Binding SelectedInstrument, Converter={StaticResource InstrumentVisibilityConverter}, ConverterParameter=开盖分液}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Padding="16" Background="#F6F8FA" BorderBrush="#D0D7DE"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="4" FontSize="18" FontWeight="SemiBold"
                                   Text="开盖分液工作站状态" />
                        <TextBlock Grid.Row="1" Margin="0,14,8,0" Foreground="Gray" Text="工作站 ID" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,14,8,0"
                                   Text="{Binding SampleWorkstationDeviceId}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,14,8,0" Foreground="Gray" Text="接口" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,14,0,0"
                                   Text="{Binding WorkstationConnectionStatus}" />
                        <TextBlock Grid.Row="2" Margin="0,8,8,0" Foreground="Gray" Text="在线状态" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,8,0"
                                   FontWeight="SemiBold" Text="{Binding WorkstationOnline}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="仪器状态" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,8,0,0"
                                   Text="{Binding WorkstationState}" />
                        <TextBlock Grid.Row="3" Margin="0,8,8,0" Foreground="Gray" Text="原始状态码" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,8,0"
                                   Text="{Binding WorkstationRawState}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="观测时间" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,8,0,0"
                                   Text="{Binding WorkstationObservedAt}" />
                        <TextBlock Grid.Row="4" Margin="0,8,8,0" Foreground="Gray" Text="错误信息" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Text="{Binding WorkstationError}" />
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="4" Margin="0,16,0,0"
                                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                   Text="{Binding WorkstationAvailabilityMessage}" />
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0" Padding="16" Background="White"
                        BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="最近任务" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Foreground="Gray" Text="任务编号" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkstationLatestTaskNo}" />
                            <TextBlock Grid.Column="2" Foreground="Gray" Text="任务状态" />
                            <TextBlock Grid.Column="3" Text="{Binding WorkstationLatestTaskState}" />
                            <TextBlock Grid.Row="1" Margin="0,8,8,0" Foreground="Gray" Text="任务名称" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,8,0"
                                       Text="{Binding WorkstationLatestTaskName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="生成时间" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"
                                       Text="{Binding WorkstationLatestTaskTime}" />
                        </Grid>
                        <DataGrid Margin="0,14,0,0" ItemsSource="{Binding WorkstationTasks}"
                                  SelectedItem="{Binding SelectedWorkstationTask, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" HeadersVisibility="Column" MinHeight="80"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="1.2*" MinWidth="100" Header="任务编号" Binding="{Binding TaskNo}" />
                                <DataGridTextColumn Width="1.5*" MinWidth="120" Header="任务名称" Binding="{Binding TaskName}" />
                                <DataGridTextColumn Width="0.8*" MinWidth="70" Header="状态" Binding="{Binding State}" />
                                <DataGridTextColumn Width="1.2*" MinWidth="110" Header="生成时间" Binding="{Binding MakeTime}" />
                                <DataGridTextColumn Width="1.5*" MinWidth="100" Header="备注" Binding="{Binding Remark}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Margin="0,14,0,0" Padding="14"
                                Background="#FFF8E8" BorderBrush="#E2B04A" BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding IsWorkstationTestControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="联调测试" />
                                <TextBlock Margin="0,4,0,0" Foreground="#7A3E00" TextWrapping="Wrap"
                                           Text="此入口仅用于设备接入测试，正式运行由实验工作流统一调度。" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="Gray" Text="选中任务" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedWorkstationTaskNo}" />
                                    <TextBlock Grid.Column="2" Foreground="Gray" Text="当前状态" />
                                    <TextBlock Grid.Column="3" Text="{Binding SelectedWorkstationTaskState}" />
                                </Grid>
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <Button Width="130" Height="34"
                                            Command="{Binding StartWorkstationTestTaskCommand}"
                                            Content="启动测试任务" />
                                    <TextBlock Margin="14,7,0,0" TextWrapping="Wrap"
                                               Text="{Binding WorkstationTestControlMessage}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
