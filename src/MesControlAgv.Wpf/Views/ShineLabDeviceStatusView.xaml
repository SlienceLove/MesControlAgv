<UserControl x:Class="MesControlAgv.Wpf.Views.ShineLabDeviceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MesControlAgv.Wpf.Converters">
    <UserControl.Resources><converters:InstrumentVisibilityConverter x:Key="InstrumentVisibilityConverter" /></UserControl.Resources>
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding InstrumentTitle}" />
                <TextBlock Margin="0,4,0,0" Foreground="Gray"
                           Text="{Binding InstrumentDescription}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Width="100" Height="34"
                    Command="{Binding RefreshCommand}" Content="刷新状态" />
        </DockPanel>

        <TabControl Grid.Row="1" Margin="0,0,0,14" ItemsSource="{Binding InstrumentOptions}" SelectedItem="{Binding SelectedInstrument, Mode=TwoWay}">
            <TabControl.ItemTemplate><DataTemplate><TextBlock Padding="18,8" FontSize="16" FontWeight="SemiBold" Text="{Binding}" /></DataTemplate></TabControl.ItemTemplate>
            <TabControl.ContentTemplate><DataTemplate><TextBlock Margin="12,4" Foreground="Gray" Text="选择当前大设备后查看其子设备状态" /></DataTemplate></TabControl.ContentTemplate>
        </TabControl>
        <Grid x:Name="DeviceSummaryGrid" Grid.Row="2" Margin="0,0,0,14"
              Visibility="{Binding SelectedInstrument, Converter={StaticResource InstrumentVisibilityConverter}, ConverterParameter=离子色谱}"
              MinWidth="0" SizeChanged="DeviceSummaryGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="0" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="0" />
                <ColumnDefinition Width="3*" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DeviceListHost" Grid.Row="0" Grid.Column="0" Margin="0,0,12,0" Padding="12" Background="#F6F8FA"
                    BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="已发现设备" />
                    <ListBox Margin="0,8,0,0" ItemsSource="{Binding VisibleDevices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DeviceName}" />
                                        <TextBlock FontSize="11" Foreground="Gray" Text="{Binding EquipmentCode}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding State}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="Gray"
                               TextWrapping="Wrap" Text="{Binding Message}" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="SelectedDeviceScrollViewer" Grid.Row="0" Grid.Column="1"
                          Margin="0" MinWidth="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Border Padding="16" Background="White"
                    BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="4" FontSize="18" FontWeight="SemiBold" Text="所选设备" />
                    <TextBlock Grid.Row="1" Margin="0,14,8,0" Foreground="Gray" Text="设备" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,14,8,0" Text="{Binding SelectedDeviceName}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,14,8,0" Foreground="Gray" Text="连接" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,14,0,0" FontWeight="SemiBold" Text="{Binding SelectedOnline}" />
                    <TextBlock Grid.Row="2" Margin="0,8,8,0" Foreground="Gray" Text="设备状态" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,8,0" Text="{Binding SelectedState}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="任务" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,8,0,0" Text="{Binding SelectedTaskState}" />
                    <TextBlock Grid.Row="3" Margin="0,8,8,0" Foreground="Gray" Text="当前样品" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,8,0" Text="{Binding SelectedSample}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="通道/位置" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,8,0,0" Text="{Binding SelectedChannelPosition}" />
                    <TextBlock Grid.Row="4" Margin="0,8,8,0" Foreground="Gray" Text="阶段/进度" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,8,0" Text="{Binding SelectedStage}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="报警" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Margin="0,8,0,0" Text="{Binding SelectedAlarm}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" Margin="0,8,8,0" Foreground="Gray" Text="任务号" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,8,8,0" Text="{Binding SelectedTaskUuid}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,8,8,0" Foreground="Gray" Text="进度" />
                    <TextBlock Grid.Row="5" Grid.Column="3" Margin="0,8,0,0" Text="{Binding SelectedProgress}" />
                    <TextBlock Grid.Row="6" Margin="0,8,8,0" Foreground="Gray" Text="最后推送" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Text="{Binding SelectedLastSeen}" />
                </Grid>
            </Border>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,14" Visibility="{Binding SelectedInstrument, Converter={StaticResource InstrumentVisibilityConverter}, ConverterParameter=开盖分液}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.9*"/></Grid.ColumnDefinitions>
            <Border Margin="0,0,12,0" Padding="16" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="仪器状态"/><TextBlock Margin="0,16,0,0" Foreground="Gray" Text="接口：/GetInstrumentStatus"/><TextBlock Margin="0,10,0,0" FontSize="24" FontWeight="SemiBold" Text="等待接口数据"/><TextBlock Margin="0,6,0,0" Foreground="Gray" Text="0 空闲 · 1 运行 · 2 暂停 · 3 故障 · 4 初始化 · 5 脱机" TextWrapping="Wrap"/><TextBlock Margin="0,18,0,0" Foreground="Gray" Text="接口：/GetErrorInformation"/><TextBlock Margin="0,6,0,0" Text="暂无报错信息"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="16" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="任务状态"/><TextBlock Margin="0,12,0,0" Foreground="Gray" Text="接口：/GetTaskInformationList · /GetTaskState"/><TextBlock Margin="0,16,0,0" Text="任务编号：暂无任务"/><TextBlock Margin="0,10,0,0" Text="任务状态：等待运行"/><TextBlock Margin="0,10,0,0" Text="最近操作：—"/></StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" Padding="12" Background="White"
                BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="推送明细" />
                <DataGrid x:Name="DevicePushGrid" Margin="0,12,0,0" MinWidth="0"
                          ItemsSource="{Binding VisibleDevices}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <!-- Keep scan-level fields here; UUID, channel, position,
                             progress and last-seen details are in the selection panel. -->
                        <DataGridTextColumn Width="1.4*" MinWidth="100" Header="设备" Binding="{Binding DeviceName}" />
                        <DataGridTextColumn Width="0.8*" MinWidth="64" Header="在线" Binding="{Binding Online}" />
                        <DataGridTextColumn Width="1*" MinWidth="80" Header="状态" Binding="{Binding State}" />
                        <DataGridTextColumn Width="1.2*" MinWidth="90" Header="任务状态" Binding="{Binding HasActiveTask}" />
                        <DataGridTextColumn Width="1.5*" MinWidth="100" Header="样品" Binding="{Binding SampleName}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
