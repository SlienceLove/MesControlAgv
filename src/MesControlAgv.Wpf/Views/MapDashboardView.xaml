<UserControl x:Class="MesControlAgv.Wpf.Views.MapDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MesControlAgv.Wpf"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MesControlAgv.Wpf;component/Themes/MesTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:MapBezierGeometryConverter x:Key="MapBezierGeometryConverter" />
            <local:MapRasterImageSourceConverter x:Key="MapRasterImageSourceConverter" />
            <local:MapRouteColorConverter x:Key="MapRouteColorConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="只读地图视图" />
                        <TextBlock Margin="0,4,0,0" Foreground="Gray" Text="配置地图几何、实时 AGV 状态和路径叠加" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Height="28" Padding="10,0" Background="#1769AA" Foreground="White" Content="导入 SMAP 地图" Click="ImportMap_Click" ToolTip="选择 .smap 文件加载地图" AutomationProperties.Name="导入 SMAP 地图文件" />
                            <Separator Margin="8,0" Width="1" Background="#D0D7DE" />
                            <Button Width="32" Height="28" Content="−" Click="MapZoomOut_Click" ToolTip="缩小地图" />
                            <Button Width="32" Height="28" Margin="6,0,0,0" Content="+" Click="MapZoomIn_Click" ToolTip="放大地图" />
                            <Button Height="28" Margin="6,0,0,0" Padding="10,0" Content="路线区域" Click="MapFitRoute_Click" ToolTip="聚焦站点和可行驶路线" />
                            <Button Height="28" Margin="6,0,0,0" Padding="10,0" Content="完整地图" Click="MapFit_Click" ToolTip="显示完整 .smap 边界" />
                            <Button Width="32" Height="28" Margin="6,0,0,0" Content="↺" Click="MapReset_Click" ToolTip="重置视图" />
                            <Button Height="28" Margin="6,0,0,0" Padding="10,0" Content="导出当前 PNG" Click="MapExportCurrent_Click" ToolTip="导出当前地图视口" AutomationProperties.Name="导出当前地图视口 PNG" />
                            <Button Height="28" Margin="6,0,0,0" Padding="10,0" Content="导出完整 PNG" Click="MapExportFull_Click" ToolTip="导出未变换的完整地图" AutomationProperties.Name="导出完整地图 PNG" />
                        </StackPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="墙线" IsChecked="{Binding Readiness.Map.Layers.ShowWalls, Mode=TwoWay}" />
                            <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="路线" IsChecked="{Binding Readiness.Map.Layers.ShowRoutes, Mode=TwoWay}" />
                            <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="站点标签" IsChecked="{Binding Readiness.Map.Layers.ShowStationLabels, Mode=TwoWay}" />
                            <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="运行叠加"
                                      IsEnabled="{Binding Readiness.Map.Layers.RuntimeOverlayAllowed}"
                                      IsChecked="{Binding Readiness.Map.Layers.ShowRuntimeOverlays, Mode=TwoWay}" />
                            <CheckBox VerticalAlignment="Center" Content="障碍扫描" ToolTip="显示 .smap 的障碍扫描点"
                                      IsEnabled="{Binding Readiness.Map.Raster.HasData}"
                                      IsChecked="{Binding Readiness.Map.Layers.ShowRasterBackground, Mode=TwoWay}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Readiness.Map.Fingerprint}" />
                        <TextBlock Margin="0,3,0,0" Foreground="Gray" Text="{Binding Readiness.Map.LiveFingerprint}" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Readiness.Map.SyncStatus, StringFormat=地图同步：{0}}" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Readiness.MapLayoutVerificationStatus, StringFormat=布局校验：{0}}" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MapViewportHost" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                            PreviewMouseWheel="MapCanvas_MouseWheel"
                            PreviewMouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                            PreviewMouseMove="MapCanvas_MouseMove"
                            PreviewMouseLeftButtonUp="MapCanvas_MouseLeftButtonUp">
                        <ScrollViewer x:Name="MapScrollViewer" Background="#FBFCFE" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                            <Canvas x:Name="MapTransformHost"
                                    Width="{Binding Readiness.Map.CanvasWidth}"
                                    Height="{Binding Readiness.Map.CanvasHeight}">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding Readiness.Viewport.Scale}" ScaleY="{Binding Readiness.Viewport.Scale}" />
                                        <TranslateTransform X="{Binding Readiness.Viewport.OffsetX}" Y="{Binding Readiness.Viewport.OffsetY}" />
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Canvas x:Name="MapCanvas"
                                        Width="{Binding Readiness.Map.CanvasWidth}"
                                        Height="{Binding Readiness.Map.CanvasHeight}"
                                        Background="#FBFCFE">
                                <Image Width="{Binding Readiness.Map.CanvasWidth}"
                                       Height="{Binding Readiness.Map.CanvasHeight}"
                                       Stretch="Fill"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding DataContext.Readiness.Map.Layers.ShowRasterBackground, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Source="{Binding Readiness.Map.Raster, Converter={StaticResource MapRasterImageSourceConverter}}" />
                                <ItemsControl ItemsSource="{Binding Readiness.Map.WallSegments}"
                                              Visibility="{Binding DataContext.Readiness.Map.Layers.ShowWalls, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding Converter={StaticResource MapBezierGeometryConverter}}"
                                                  Stroke="#64748B" StrokeThickness="0.6" Opacity="0.72"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Readiness.Map.Edges}"
                                              Visibility="{Binding DataContext.Readiness.Map.Layers.ShowRoutes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding Converter={StaticResource MapBezierGeometryConverter}}"
                                                  Stroke="{Binding Bidirectional, Converter={StaticResource MapRouteColorConverter}}" StrokeThickness="1.0"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Readiness.Map.Edges}"
                                              Visibility="{Binding DataContext.Readiness.Map.Layers.ShowRoutes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding ArrowX}" />
                                            <Setter Property="Canvas.Top" Value="{Binding ArrowY}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Polygon Points="0,0 -6,-3 -6,3" Fill="#315B87">
                                                <Polygon.RenderTransform>
                                                    <RotateTransform Angle="{Binding ArrowAngle}" />
                                                </Polygon.RenderTransform>
                                            </Polygon>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Readiness.Map.AgvPathSegments}"
                                              Visibility="{Binding DataContext.Readiness.Map.Layers.ShowRuntimeOverlays, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding Converter={StaticResource MapBezierGeometryConverter}}"
                                                  Stroke="#D97706" StrokeThickness="1.5" Opacity="0.65" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Readiness.Map.Nodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="80" Height="40" Padding="0" Background="Transparent" BorderThickness="0"
                                                    ToolTip="{Binding Enabled, StringFormat=启用：{0}}"
                                                    AutomationProperties.Name="{Binding StationId}"
                                                    Click="MapStation_Click">
                                                <Canvas Width="80" Height="40" Background="Transparent">
                                                <Ellipse Width="12" Height="12" Canvas.Left="34" Canvas.Top="14"
                                                         Fill="#E8F1FF" Stroke="#4285C5" StrokeThickness="1.5" />
                                                <TextBlock Canvas.Left="6" Canvas.Top="-6" Padding="2,0"
                                                           Background="#FBFCFE" FontWeight="SemiBold" FontSize="9"
                                                           Visibility="{Binding DataContext.Readiness.Map.Layers.ShowStationLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Text="{Binding DisplayText}" />
                                                </Canvas>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Readiness.Map.VisualAgvs}"
                                              Visibility="{Binding DataContext.Readiness.Map.Layers.ShowRuntimeOverlays, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="1" Height="1">
                                                <Polygon Points="0,0 -7,-3.5 -7,3.5" Fill="#D97706">
                                                    <Polygon.RenderTransform>
                                                        <RotateTransform Angle="{Binding HeadingDegrees}" />
                                                    </Polygon.RenderTransform>
                                                </Polygon>
                                                <Border Canvas.Left="-4" Canvas.Top="-28" Padding="5" Background="#FFF7ED" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding AgvId}" />
                                                        <TextBlock FontSize="10" Text="{Binding CurrentStation}" />
                                                    </StackPanel>
                                                </Border>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </Canvas>
                            </Canvas>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="实时叠加" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Readiness.Map.Agvs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="8" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" />
                                                <TextBlock Margin="0,3,0,0" Foreground="Gray" Text="{Binding CurrentStation}" />
                                                <TextBlock Margin="0,3,0,0" Foreground="#315B87" TextWrapping="Wrap" Text="{Binding PathText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="站点详情"
                                       Visibility="{Binding Readiness.Map.StationSelection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border Padding="8" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4"
                                    Visibility="{Binding Readiness.Map.StationSelection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Readiness.Map.StationSelection.SelectedDetail.DisplayName}" />
                                    <TextBlock Margin="0,3,0,0" Foreground="Gray" Text="{Binding Readiness.Map.StationSelection.SelectedDetail.SmapStationId, StringFormat=.smap 标记：{0}}" />
                                    <TextBlock Margin="0,3,0,0" Foreground="Gray" Text="{Binding Readiness.Map.StationSelection.SelectedDetail.MesStationText, StringFormat=MES 站点：{0}}" />
                                    <TextBlock Margin="0,3,0,0" Foreground="Gray" Text="{Binding Readiness.Map.StationSelection.SelectedDetail.CoordinateText, StringFormat=坐标：{0}}" />
                                    <TextBlock Margin="0,3,0,0" Foreground="Gray" Text="{Binding Readiness.Map.StationSelection.SelectedDetail.Enabled, StringFormat=启用：{0}}" />
                                    <TextBlock Margin="0,3,0,0" Foreground="#315B87" TextWrapping="Wrap" Text="{Binding Readiness.Map.StationSelection.SelectedDetail.RouteText, StringFormat=关联路线：{0}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="布局校验详情" />
                            <TextBlock Foreground="#B42318" TextWrapping="Wrap" Text="{Binding Readiness.MapLayoutVerificationDetails}" />
                            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="图例" />
                            <TextBlock Foreground="#315B87" Text="蓝色：有向路线" />
                            <TextBlock Foreground="#1E293B" Text="深色：.smap 障碍扫描点" />
                            <TextBlock Foreground="#64748B" Text="灰蓝：.smap 特征勾勒线" />
                            <TextBlock Foreground="#D97706" Text="橙色：报告的活动路径" />
                            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="安全" />
                            <TextBlock Foreground="#B42318" TextWrapping="Wrap" Text="此视图不提供派发或 AGV 控制操作。" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
</UserControl>
