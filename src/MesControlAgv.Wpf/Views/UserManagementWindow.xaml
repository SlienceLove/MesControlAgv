<Window x:Class="MesControlAgv.Wpf.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户权限管理" Width="1040" Height="660" MinWidth="780" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#F3F6FB">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="用户权限管理" FontSize="24" FontWeight="SemiBold" Foreground="#123158"/><TextBlock Text="管理员 / 操作员 / 只读用户 · 账号变更后原会话失效" Margin="0,7,0,18" Foreground="#667085"/></StackPanel>
        <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,14">
            <Button x:Name="CreateUserButton" Content="创建账号" Click="Create_Click" Padding="16,8" Background="#1769AA" Foreground="White" Margin="0,0,10,4"/>
            <Button x:Name="EditUserButton" Content="编辑姓名 / 角色" Click="Edit_Click" Padding="14,8" Margin="0,0,10,4"/>
            <Button x:Name="ToggleUserButton" Content="启用 / 停用" Click="Toggle_Click" Padding="14,8" Margin="0,0,10,4"/>
            <Button x:Name="ResetPasswordButton" Content="重置密码" Click="Reset_Click" Padding="14,8" Margin="0,0,10,4"/>
            <Button Content="刷新" Click="Refresh_Click" Padding="14,8" Margin="0,0,0,4"/>
        </WrapPanel>
        <DataGrid x:Name="UsersGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="账号" Binding="{Binding Username, Mode=OneWay}" Width="150"/>
                <DataGridTextColumn Header="姓名" Binding="{Binding DisplayName, Mode=OneWay}" Width="*" MinWidth="130"/>
                <DataGridTextColumn Header="角色" Binding="{Binding RoleDisplay, Mode=OneWay}" Width="120"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="90"/>
                <DataGridTextColumn Header="最近登录（本地时间）" Binding="{Binding LastLoginDisplay, Mode=OneWay}" Width="190"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" x:Name="Status" Margin="0,14,0,0" Foreground="#475467" TextWrapping="Wrap" MinHeight="24"/>
    </Grid>
</Window>
