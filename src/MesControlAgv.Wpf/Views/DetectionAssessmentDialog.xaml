<Window x:Class="MesControlAgv.Wpf.Views.DetectionAssessmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="样品检测判定" Width="880" Height="680" MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.4*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Padding="10,5" Click="Close_Click" Content="关闭" />
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="样品检测判定" />
                <TextBlock Margin="0,3,0,0" Foreground="Gray" Text="{Binding Sample.Barcode, StringFormat=样品条码：{0}}" />
            </StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" Text="检测方法" />
            <ComboBox MinWidth="320" ItemsSource="{Binding Standards}" SelectedItem="{Binding SelectedStandard, Mode=TwoWay}"
                      IsEnabled="{Binding IsMethodSelectionEnabled}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MethodCode}" FontWeight="SemiBold" />
                            <TextBlock Margin="8,0,0,0" Text="{Binding Name}" />
                            <TextBlock Margin="8,0,0,0" Foreground="Gray" Text="{Binding Revision, StringFormat=v{0}}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Measurements}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="本次检测" Width="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="指标" Binding="{Binding Name}" IsReadOnly="True" Width="1.4*" />
                <DataGridTextColumn Header="检测值" Binding="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" IsReadOnly="True" Width="0.7*" />
                <DataGridTextColumn Header="检出限" Binding="{Binding DetectionLimit}" IsReadOnly="True" Width="0.8*" />
                <DataGridTextColumn Header="合格范围" Binding="{Binding Range}" IsReadOnly="True" Width="1.5*" />
                <DataGridTextColumn Header="预览" Binding="{Binding PreviewVerdict}" IsReadOnly="True" Width="0.8*" />
                <DataGridTextColumn Header="说明" Binding="{Binding PreviewReason}" IsReadOnly="True" Width="1.2*" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,10,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Padding="12,6" Margin="0,0,8,0" Command="{Binding PreviewCommand}" Content="预览判定" />
                <Button Padding="14,6" Background="#1769AA" Foreground="White"
                        Command="{Binding SaveCommand}" Content="保存记录" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="{Binding VerdictText}" />
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Text="{Binding Status}" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,6" FontWeight="SemiBold" Text="历史判定" />
            <DataGrid Grid.Row="1" Margin="0,0,8,0" ItemsSource="{Binding History}"
                      SelectedItem="{Binding SelectedHistory, Mode=TwoWay}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding AssessedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="1.4*" />
                    <DataGridTextColumn Header="方法" Binding="{Binding MethodCode}" Width="1*" />
                    <DataGridTextColumn Header="版本" Binding="{Binding Revision}" Width="50" />
                    <DataGridTextColumn Header="结论" Binding="{Binding VerdictText}" Width="0.8*" />
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SelectedHistory.Items}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="指标" Binding="{Binding Name}" Width="1*" />
                    <DataGridTextColumn Header="检测值" Binding="{Binding Value}" Width="0.8*" />
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="0.7*" />
                    <DataGridTextColumn Header="结论" Binding="{Binding VerdictText}" Width="0.8*" />
                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="1.2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
