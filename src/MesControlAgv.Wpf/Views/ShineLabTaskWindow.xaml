<Window x:Class="MesControlAgv.Wpf.Views.ShineLabTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MesControlAgv.Wpf.Views"
        Title="离子色谱 · 样品任务" Width="1200" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Themes/MesTheme.xaml"/>
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <views:ShineLabControlView x:Name="TaskView" DisplayMode="Tasks"/>
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click" IsEnabled="{Binding IsInteractive}" Padding="20,6"/>
            <TextBlock Text="导入和预检不会启动实验；下发需确认。操作处理中请等待完成后关闭。"
                       TextWrapping="Wrap" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
