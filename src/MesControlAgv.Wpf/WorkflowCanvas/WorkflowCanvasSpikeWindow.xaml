<Window x:Class="MesControlAgv.Wpf.WorkflowCanvas.WorkflowCanvasSpikeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:MesControlAgv.Wpf.WorkflowCanvas"
        Title="实验流程画布 Spike"
        Width="1540"
        Height="940"
        MinWidth="1200"
        MinHeight="760"
        Background="#F2F4F7"
        KeyDown="Window_KeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#101828" Text="实验流程画布 Spike" />
                    <TextBlock Margin="0,3,0,0" Foreground="#667085" Text="仅使用内存样例，不连接 MES、AGV、机械臂或仪器。" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,7,0" Foreground="#475467" Text="模式" />
                    <ComboBox Width="100" AutomationProperties.Name="画布模式" ItemsSource="{Binding CanvasModes}" SelectedItem="{Binding CanvasMode}" />
                    <Button Margin="12,0,0,0" Padding="10,5" Click="FitToContent_Click" Content="适应画布" ToolTip="适应画布" />
                    <Button Margin="6,0,0,0" Padding="10,5" Command="{Binding AutoLayoutCommand}" Content="自动布局" ToolTip="自动布局" />
                    <Button Margin="6,0,0,0" Padding="10,5" Command="{Binding RoundTripCommand}" Content="JSON 往返" ToolTip="验证内存中的保存和加载往返" />
                    <Button Margin="6,0,0,0" Padding="10,5" Command="{Binding UndoCommand}" Content="撤销" ToolTip="撤销 (Ctrl+Z)" />
                    <Button Margin="6,0,0,0" Padding="10,5" Command="{Binding RedoCommand}" Content="重做" ToolTip="重做 (Ctrl+Y)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12" MinWidth="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Padding="12" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="#344054" Text="验收数据集" />
                        <ItemsControl Margin="0,8,0,16" ItemsSource="{Binding DatasetOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,6"
                                            Padding="8"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.LoadDatasetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#667085" TextWrapping="Wrap" Text="{Binding Description}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock FontWeight="SemiBold" Foreground="#344054" Text="节点工具箱" />
                        <Button Margin="0,8,0,6" Padding="8" HorizontalContentAlignment="Left" Command="{Binding AddNodeCommand}" CommandParameter="agv.navigate-to-station" Content="AGV 移动到站点" />
                        <Button Margin="0,0,0,6" Padding="8" HorizontalContentAlignment="Left" Command="{Binding AddNodeCommand}" CommandParameter="robot.execute-program" Content="机械臂执行程序" />
                        <Button Margin="0,0,0,6" Padding="8" HorizontalContentAlignment="Left" Command="{Binding AddNodeCommand}" CommandParameter="instrument.read-status" Content="仪器读取状态" />
                        <Button Margin="0,0,0,6" Padding="8" HorizontalContentAlignment="Left" Command="{Binding AddNodeCommand}" CommandParameter="control.wait-for-signal" Content="等待外部信号" />
                        <Button Padding="8" HorizontalContentAlignment="Left" Command="{Binding AddNodeCommand}" CommandParameter="control.condition" Content="条件判断" />

                        <Separator Margin="0,16,0,12" />
                        <TextBlock FontWeight="SemiBold" Foreground="#344054" Text="编辑" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Padding="9,5" Command="{Binding CopyCommand}" Content="复制" ToolTip="复制 (Ctrl+C)" />
                            <Button Margin="6,0,0,0" Padding="9,5" Command="{Binding PasteCommand}" Content="粘贴" ToolTip="粘贴 (Ctrl+V)" />
                            <Button Margin="6,0,0,0" Padding="9,5" Command="{Binding DeleteCommand}" Content="删除" ToolTip="删除 (Delete)" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Margin="12,0" MinWidth="0" ClipToBounds="True" Background="#F8FAFC" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="5">
                <canvas:NodifyCanvasAdapter x:Name="CanvasSurface" MinWidth="0" HorizontalAlignment="Stretch" />
            </Border>

            <Border Grid.Column="2" Padding="12" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="#344054" Text="选中节点" />
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SelectedNode.Name}" />
                        <TextBlock Margin="0,4,0,0" Foreground="#667085" FontSize="11" TextWrapping="Wrap" Text="{Binding SelectedNode.NodeTypeId}" />
                        <TextBlock Margin="0,4,0,0" Foreground="#667085" FontSize="11" TextWrapping="Wrap" Text="{Binding SelectedNode.Description}" />
                        <TextBlock Margin="0,8,0,0" Foreground="#667085" FontSize="11" Text="{Binding SelectedNode.RuntimeState}" />

                        <Separator Margin="0,16,0,12" />
                        <TextBlock FontWeight="SemiBold" Foreground="#344054" Text="连接反馈" />
                        <TextBlock Margin="0,8,0,0" Foreground="#475467" TextWrapping="Wrap" Text="{Binding LastConnectionMessage}" />

                        <Separator Margin="0,16,0,12" />
                        <TextBlock FontWeight="SemiBold" Foreground="#344054" Text="校验定位" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,6"
                                            Padding="8"
                                            AutomationProperties.Name="{Binding Code}"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SelectIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock FontSize="10" Foreground="#B42318" Text="{Binding Code}" />
                                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Message}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="9" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="5">
            <DockPanel>
                <TextBlock Foreground="#475467" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Foreground="#667085" Text="{Binding NodeCount, StringFormat={}节点 {0}}" />
                    <TextBlock Margin="12,0,0,0" Foreground="#667085" Text="{Binding EdgeCount, StringFormat={}边 {0}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
