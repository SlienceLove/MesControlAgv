<UserControl x:Class="MesControlAgv.Wpf.WorkflowCanvas.WorkflowRunMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workflowCanvas="clr-namespace:MesControlAgv.Wpf.WorkflowCanvas">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="240" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding RunTitle}" />
                    <Border Margin="12,1,0,0"
                            Padding="8,3"
                            VerticalAlignment="Top"
                            Background="{Binding RunStatusBrush}"
                            CornerRadius="3">
                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding RunStatusDisplay}" />
                    </Border>
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Foreground="#475467" Text="{Binding RunIdentity}" />
                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#667085" Text="{Binding RunTimeSummary}" />
                <Grid Margin="0,8,0,0" MaxWidth="900">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="WorkflowRunProgressBar"
                                 Height="8"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Foreground="#475467" Text="{Binding ProgressDisplay}" />
                        <TextBlock Margin="12,0,0,0" Foreground="#667085" Text="当前：" />
                        <TextBlock Foreground="#475467"
                                   MaxWidth="430"
                                   Text="{Binding CurrentNodeDisplay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#475467" Text="实验任务" />
                    <ComboBox x:Name="WorkflowRunExperimentJobSelector" Width="410"
                              MinHeight="32"
                              AutomationProperties.AutomationId="WorkflowRunExperimentJobSelector"
                              DisplayMemberPath="Display"
                              ItemsSource="{Binding ExperimentJobOptions}"
                              SelectedItem="{Binding SelectedExperimentJob, Mode=TwoWay}"
                              ToolTip="{Binding SelectedExperimentJobHint}" />
                    <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Foreground="#475467" Text="流程步骤" />
                    <ComboBox x:Name="WorkflowRunStepSelector" Width="330"
                              MinHeight="32"
                              AutomationProperties.AutomationId="WorkflowRunStepSelector"
                              DisplayMemberPath="Display"
                              ItemsSource="{Binding ExperimentStepOptions}"
                              SelectedItem="{Binding SelectedExperimentStep, Mode=TwoWay}"
                              ToolTip="{Binding SelectedExperimentStepHint}" />
                    <Button x:Name="WorkflowRunSelectionRefreshButton" MinWidth="110"
                            Margin="8,0,0,0"
                            Padding="12,5"
                            AutomationProperties.AutomationId="WorkflowRunSelectionRefreshButton"
                            Command="{Binding RefreshExperimentJobsCommand}"
                            Content="刷新任务列表" />
                    <Button x:Name="PrepareCompositeRunButton"
                            MinWidth="150"
                            Margin="8,0,0,0"
                            Padding="12,5"
                            AutomationProperties.AutomationId="WorkflowPrepareCompositeRunButton"
                            Command="{Binding PrepareCompositeRunCommand}"
                            Content="建立复合运行"
                            IsEnabled="{Binding CanPrepareCompositeRun}"
                            ToolTip="{Binding PrepareCompositeRunUnavailableReason}"
                            ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding HasCompositeJob, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="WorkflowRunFullscreenButton"
                            MinWidth="88"
                            Margin="8,0,0,0"
                            Padding="12,5"
                            AutomationProperties.AutomationId="WorkflowRunFullscreenButton"
                            Click="OpenFullscreen_Click"
                            Content="全屏查看"
                            ToolTip="在独立大屏窗口查看流程图、当前节点、节点执行、设备操作和时间线" />
                </WrapPanel>
                <TextBlock Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="#667085"
                           Text="{Binding SelectedExperimentJobHint}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="#667085"
                           Text="{Binding SelectedExperimentStepHint}"
                           TextWrapping="Wrap" />
                <Expander x:Name="CompositeRunExpander"
                          Margin="0,7,0,0"
                          AutomationProperties.AutomationId="WorkflowCompositeRunExpander"
                          Header="复合方案步骤状态"
                          IsExpanded="True"
                          Visibility="{Binding HasCompositeRun, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Margin="0,4,0,0"
                            Padding="8"
                            Background="#F8FAFC"
                            BorderBrush="#D0D5DD"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="{Binding CompositeRunSummary}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Margin="0,3,0,5" FontSize="11" Foreground="#667085"
                                       Text="{Binding CompositeRunTimeSummary}" />
                            <DataGrid x:Name="CompositeStepStatusGrid"
                                      AutomationProperties.AutomationId="WorkflowCompositeStepStatusGrid"
                                      Grid.Row="2"
                                      MaxHeight="190"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding CompositeSteps}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="48" Header="序" Binding="{Binding Order}" />
                                    <DataGridTextColumn Width="1.4*" MinWidth="130" Header="流程" Binding="{Binding Name}" />
                                    <DataGridTextColumn Width="105" Header="状态" Binding="{Binding StatusDisplay}" />
                                    <DataGridTextColumn Width="105" Header="子流程" Binding="{Binding ChildRunDisplay}" />
                                    <DataGridTextColumn Width="200" Header="时间" Binding="{Binding TimeDisplay}" />
                                    <DataGridTextColumn Width="1.2*" MinWidth="120" Header="异常" Binding="{Binding ErrorDisplay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Expander>
                <Expander Margin="0,6,0,0"
                          IsExpanded="False"
                          Header="高级：按运行 ID 加载（通常无需填写）">
                    <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#475467" Text="运行 ID" />
                        <TextBox Width="330"
                                 MinHeight="32"
                                 AutomationProperties.AutomationId="WorkflowRunIdInput"
                                 Text="{Binding RunIdText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button MinWidth="88"
                                Margin="8,0,0,0"
                                Padding="12,5"
                                AutomationProperties.AutomationId="WorkflowRunRefreshButton"
                                Command="{Binding RefreshCommand}"
                                Content="加载 / 刷新" />
                    </WrapPanel>
                </Expander>
                <WrapPanel Margin="0,7,0,0">
                    <CheckBox x:Name="AutoRefreshCheckBox"
                              VerticalAlignment="Center"
                              AutomationProperties.AutomationId="WorkflowRunAutoRefreshCheckBox"
                              IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}"
                              Content="自动刷新" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#667085"
                               Text="{Binding AutoRefreshStatusDisplay}" />
                </WrapPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Border Padding="10,8"
                    Background="#F8FAFC"
                    BorderBrush="#D0D5DD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Margin="0,0,0,3" FontSize="11" Foreground="#475467" Text="操作者" />
                        <TextBox MinHeight="30"
                                 AutomationProperties.AutomationId="WorkflowRunOperatorInput"
                                 Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Margin="0,0,0,3" FontSize="11" Foreground="#475467" Text="操作原因（必填）" />
                        <TextBox MinHeight="30"
                                 MaxLength="2048"
                                 AutomationProperties.AutomationId="WorkflowRunControlReasonInput"
                                 Text="{Binding ControlReason, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button MinWidth="88"
                                    MinHeight="30"
                                    Padding="10,4"
                                    AutomationProperties.AutomationId="WorkflowRunPermissionCheckButton"
                                    Command="{Binding CheckPermissionsCommand}"
                                    Content="校验权限" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#475467"
                                       Text="{Binding PermissionStatus}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="#667085"
                                   Text="{Binding GrantedPermissionsDisplay}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PauseRunButton"
                                MinWidth="72"
                                MinHeight="32"
                                Margin="0,0,6,0"
                                Padding="10,4"
                                AutomationProperties.AutomationId="WorkflowRunPauseButton"
                                Command="{Binding PauseCommand}"
                                Content="暂停"
                                ToolTip="{Binding PauseUnavailableReason}"
                                ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="ResumeRunButton"
                                MinWidth="72"
                                MinHeight="32"
                                Margin="0,0,6,0"
                                Padding="10,4"
                                AutomationProperties.AutomationId="WorkflowRunResumeButton"
                                Command="{Binding ResumeCommand}"
                                Content="恢复"
                                ToolTip="{Binding ResumeUnavailableReason}"
                                ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="CancelRunButton"
                                MinWidth="84"
                                MinHeight="32"
                                Padding="10,4"
                                Background="#B42318"
                                Foreground="White"
                                AutomationProperties.AutomationId="WorkflowRunCancelButton"
                                Command="{Binding CancelCommand}"
                                Content="取消流程"
                                ToolTip="{Binding CancelUnavailableReason}"
                                ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,8,0,0"
                    Padding="10,8"
                    Background="#FCE7F3"
                    BorderBrush="#A30D5D"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasUnknownState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="#831843" FontWeight="SemiBold" Text="{Binding UnknownWarning}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#831843"
                                   Text="{Binding UnknownResolutionContext}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ResolveUnknownSucceededButton"
                                MinWidth="132"
                                MinHeight="32"
                                Margin="0,0,8,0"
                                Padding="10,4"
                                AutomationProperties.AutomationId="WorkflowUnknownConfirmSucceededButton"
                                Command="{Binding ResolveUnknownSucceededCommand}"
                                Content="记录现场已成功"
                                ToolTip="{Binding UnknownResolutionUnavailableReason}"
                                ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="ResolveUnknownFailedButton"
                                MinWidth="148"
                                MinHeight="32"
                                Padding="10,4"
                                Background="#831843"
                                Foreground="White"
                                AutomationProperties.AutomationId="WorkflowUnknownConfirmFailedButton"
                                Command="{Binding ResolveUnknownFailedCommand}"
                                Content="确认失败并终止"
                                ToolTip="{Binding UnknownResolutionUnavailableReason}"
                                ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,8,0,0"
                    Padding="10,8"
                    Background="#FFF8E7"
                    BorderBrush="#F79009"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasPhysicalGateWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Foreground="#8A5A00"
                               FontWeight="SemiBold"
                               Text="现场条件告警：流程暂不推进，等待自动复核" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="#8A5A00"
                               Text="{Binding PhysicalGateWarning}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0"
                    Padding="10,8"
                    Background="#FFF8E7"
                    BorderBrush="#F79009"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   FontWeight="SemiBold"
                                   Text="现场 Move 验收许可" />
                        <TextBlock Margin="12,0,0,0"
                                   Foreground="#8A5A00"
                                   Text="{Binding FieldAcceptanceStatus}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="12,0,0,0"
                                   Foreground="#475467"
                                   Text="{Binding PhysicalGateStatus}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock FontSize="11" Foreground="#667085" Text="AGV ID" />
                            <TextBox MinHeight="28"
                                     AutomationProperties.AutomationId="WorkflowFieldAgvIdInput"
                                     Text="{Binding FieldAgvId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock FontSize="11" Foreground="#667085" Text="起点站" />
                            <TextBox MinHeight="28"
                                     AutomationProperties.AutomationId="WorkflowFieldSourceStationInput"
                                     Text="{Binding FieldSourceStationId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock FontSize="11" Foreground="#667085" Text="安全监护人" />
                            <TextBox MinHeight="28"
                                     AutomationProperties.AutomationId="WorkflowFieldSafetyObserverInput"
                                     Text="{Binding FieldSafetyObserverName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock FontSize="11" Foreground="#667085" Text="许可编号" />
                            <TextBox MinHeight="28"
                                     AutomationProperties.AutomationId="WorkflowFieldPermitIdInput"
                                     Text="{Binding FieldPermitId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock FontSize="11" Foreground="#667085" Text="有效分钟" />
                            <TextBox MinHeight="28"
                                     AutomationProperties.AutomationId="WorkflowFieldPermitMinutesInput"
                                     Text="{Binding FieldPermitMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="5" Margin="0,0,8,0">
                            <TextBlock FontSize="11" Foreground="#667085" Text="说明" />
                            <TextBox MinHeight="28"
                                     MaxLength="2048"
                                     AutomationProperties.AutomationId="WorkflowFieldDescriptionInput"
                                     Text="{Binding FieldDescription, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button x:Name="CreateFieldAcceptanceButton"
                                Grid.Column="6"
                                MinWidth="132"
                                MinHeight="30"
                                Padding="10,4"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="WorkflowFieldCreateAuthorizeButton"
                                Command="{Binding CreateAndAuthorizeFieldMoveCommand}"
                                Content="创建并授权"
                                ToolTip="{Binding FieldMoveUnavailableReason}"
                                ToolTipService.ShowOnDisabled="True" />
                    </Grid>
                    <TextBlock Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="#8A5A00"
                               Text="WPF 不直接派发 AGV；只有 PhysicalAcceptance、现场 worker 显式启用且许可有效时才会认领节点。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="WorkflowFailureEvidencePanel"
                    Margin="0,8,0,0"
                    Padding="10,8"
                    Background="#FFF1F0"
                    BorderBrush="#F04438"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasFailureEvidence, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Foreground="#B42318" FontWeight="SemiBold" Text="运行失败证据" />
                    <TextBlock Margin="0,3,0,0" Foreground="#B42318" Text="{Binding FailureReasonDisplay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="WorkflowCancellationPanel"
                    Margin="0,8,0,0"
                    Padding="10,8"
                    Background="#FFF1F0"
                    BorderBrush="#B42318"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding IsCancelled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Foreground="#B42318" FontWeight="SemiBold" Text="{Binding CancellationStatusDisplay}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Grid x:Name="RunCanvasWorkspaceGrid" Grid.Row="2" MinHeight="240" MinWidth="0"
              SizeChanged="RunCanvasWorkspaceGrid_SizeChanged"
              Visibility="{Binding HasRun, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RunCanvasColumn" Width="2*" MinWidth="0" />
                <ColumnDefinition x:Name="RunInspectorColumn" Width="390" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border MinHeight="220"
                    BorderBrush="#D0D5DD"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="10,7">
                        <Button DockPanel.Dock="Right"
                                MinWidth="72"
                                Padding="10,4"
                                Click="RunCanvas_FitToContent"
                                Content="适应画布" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="只读运行画布" />
                            <TextBlock Margin="16,0,0,0" Foreground="#247A3D" Text="● 已完成" />
                            <TextBlock Margin="12,0,0,0" Foreground="#0F766E" Text="● 运行中" />
                            <TextBlock Margin="12,0,0,0" Foreground="#8A5A00" Text="● 等待" />
                            <TextBlock Margin="12,0,0,0" Foreground="#B42318" Text="● 失败" />
                            <TextBlock Margin="12,0,0,0" Foreground="#A30D5D" Text="● 未知" />
                        </StackPanel>
                    </DockPanel>
                    <workflowCanvas:NodifyCanvasAdapter x:Name="RunCanvasSurface"
                                                        Grid.Row="1"
                                                        AutomationProperties.AutomationId="WorkflowRunCanvasSurface" />
                </Grid>
            </Border>

            <Border x:Name="RunInspectorPanel" Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="14"
                    BorderBrush="#D0D5DD"
                    BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="当前节点" />
                        <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding SelectedNode.NodeName}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#667085" Text="{Binding SelectedNode.NodeTypeId}" />
                        <Border Margin="0,8,0,0"
                                Padding="7,3"
                                HorizontalAlignment="Left"
                                Background="{Binding SelectedNode.StatusBrush}"
                                CornerRadius="3">
                            <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding SelectedNode.StatusDisplay}" />
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Foreground="#667085" Text="节点执行 ID" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedNode.Id}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Foreground="#667085" Text="尝试次数" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedNode.Attempt}" />
                            <TextBlock Grid.Row="2" Foreground="#667085" Text="开始时间" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedNode.StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                            <TextBlock Grid.Row="3" Foreground="#667085" Text="完成时间" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedNode.CompletedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                            <TextBlock Grid.Row="4" Foreground="#667085" Text="持续时间" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedNode.DurationDisplay}" />
                            <TextBlock Grid.Row="5" Foreground="#667085" Text="最后错误" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Foreground="#B42318" Text="{Binding SelectedNode.LastError}" TextWrapping="Wrap" />
                        </Grid>

                        <Separator Margin="0,14,0,10" />
                        <TextBlock FontWeight="SemiBold" Text="输入快照" />
                        <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding SelectedNode.Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="#667085" Text="{Binding Key}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="输出摘要" />
                        <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding SelectedNode.Outputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="#667085" Text="{Binding Key}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,14,0,10" />
                        <TextBlock FontWeight="SemiBold" Text="设备证据" />
                        <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="{Binding SelectedDeviceOperation.CapabilityId}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0" Foreground="{Binding SelectedDeviceOperation.StatusBrush}" FontWeight="SemiBold" Text="{Binding SelectedDeviceOperation.StatusDisplay}" />
                        <TextBlock Margin="0,6,0,0" Foreground="#667085" Text="操作 ID" />
                        <TextBlock Text="{Binding SelectedDeviceOperation.OperationId}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Foreground="#667085" Text="请求 ID / 关联 ID" />
                        <TextBlock Text="{Binding SelectedDeviceOperation.RequestId}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedDeviceOperation.CorrelationId}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Foreground="#667085" Text="请求摘要" />
                        <TextBlock Text="{Binding SelectedDeviceOperation.RequestSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Foreground="#667085" Text="结果摘要" />
                        <TextBlock Text="{Binding SelectedDeviceOperation.ResultOrErrorSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border x:Name="CompositeRunCanvasPlaceholder"
                Grid.Row="2"
                Margin="0,0,0,0"
                Padding="24"
                Background="#F8FAFC"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasCompositeRun, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="复合方案步骤监控" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="#475467"
                           Text="子流程启动后将在这里显示对应的节点、设备操作和审计证据。"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="#667085"
                           Text="当前先显示外层步骤状态，不要求输入运行 ID。" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="3" Margin="0,10,0,0">
            <TabItem Header="节点执行">
                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="170" Header="节点" Binding="{Binding NodeName}" />
                        <DataGridTextColumn Width="150" Header="类型" Binding="{Binding NodeTypeId}" />
                        <DataGridTextColumn Width="90" Header="状态" Binding="{Binding StatusDisplay}" />
                        <DataGridTextColumn Width="60" Header="尝试" Binding="{Binding Attempt}" />
                        <DataGridTextColumn Width="145" Header="开始" Binding="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        <DataGridTextColumn Width="90" Header="耗时" Binding="{Binding DurationDisplay}" />
                        <DataGridTextColumn Width="2*" Header="输入" Binding="{Binding InputSummary}" />
                        <DataGridTextColumn Width="*" Header="错误" Binding="{Binding LastError}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="设备操作">
                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding DeviceOperations}"
                          SelectedItem="{Binding SelectedDeviceOperation, Mode=TwoWay}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="155" Header="节点" Binding="{Binding NodeName}" />
                        <DataGridTextColumn Width="210" Header="能力" Binding="{Binding CapabilityId}" />
                        <DataGridTextColumn Width="90" Header="状态" Binding="{Binding StatusDisplay}" />
                        <DataGridTextColumn Width="235" Header="操作 ID" Binding="{Binding OperationId}" />
                        <DataGridTextColumn Width="235" Header="请求 ID" Binding="{Binding RequestId}" />
                        <DataGridTextColumn Width="145" Header="请求时间" Binding="{Binding RequestedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        <DataGridTextColumn Width="2*" Header="请求摘要" Binding="{Binding RequestSummary}" />
                        <DataGridTextColumn Width="*" Header="结果 / 错误" Binding="{Binding ResultOrErrorSummary}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="时间线">
                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Timeline}"
                          SelectedItem="{Binding SelectedTimelineEntry, Mode=TwoWay}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="155" Header="时间" Binding="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        <DataGridTextColumn Width="220" Header="事件" Binding="{Binding EventType}" />
                        <DataGridTextColumn Width="120" Header="结果" Binding="{Binding Outcome}" />
                        <DataGridTextColumn Width="120" Header="操作者" Binding="{Binding Actor}" />
                        <DataGridTextColumn Width="190" Header="代码" Binding="{Binding Code}" />
                        <DataGridTextColumn Width="2*" Header="原因" Binding="{Binding Reason}" />
                        <DataGridTextColumn Width="*" Header="白名单详情" Binding="{Binding DetailSummary}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right"
                       Foreground="#667085"
                       Text="{Binding RefreshedAt, StringFormat={}刷新时间 {0:HH:mm:ss}}" />
            <TextBlock Foreground="#475467" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
