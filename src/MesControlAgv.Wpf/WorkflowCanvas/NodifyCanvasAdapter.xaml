<UserControl x:Class="MesControlAgv.Wpf.WorkflowCanvas.NodifyCanvasAdapter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             Background="#F7F8FA"
             MinWidth="0"
             HorizontalAlignment="Stretch">
    <Grid>
        <nodify:NodifyEditor x:Name="Editor"
                             Background="#F8FAFC"
                             MinWidth="0"
                             HorizontalAlignment="Stretch"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             SelectedItems="{Binding SelectedNodes, Mode=TwoWay}"
                             SelectedConnection="{Binding SelectedConnection, Mode=TwoWay}"
                             PendingConnection="{Binding PendingConnection, Mode=TwoWay}"
                             ConnectionCompletedCommand="{Binding CompleteConnectionCommand}"
                             ItemsDragCompletedCommand="{Binding CommitNodeLocationsCommand}"
                             GridCellSize="20"
                             DisplayConnectionsOnTop="False">
            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate>
                    <nodify:PendingConnection AllowOnlyConnectors="True"
                                             EnablePreview="True"
                                             EnableSnapping="True"
                                             Stroke="#155EEF"
                                             StrokeThickness="2" />
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>

            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="nodify:ItemContainer">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    <Setter Property="IsDraggable" Value="{Binding IsEditing}" />
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate>
                    <Canvas>
                        <nodify:Connection Source="{Binding SourcePoint}"
                                           Target="{Binding TargetPoint}"
                                           SourceOffsetMode="None"
                                           TargetOffsetMode="None"
                                           Stroke="{Binding Stroke}"
                                           StrokeThickness="2.2"
                                           IsSelectable="True"
                                           OutlineThickness="5"
                                           Cursor="Hand"
                                           ArrowSize="9,7">
                            <nodify:Connection.Style>
                                <Style TargetType="nodify:Connection">
                                    <Setter Property="OutlineBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="OutlineBrush" Value="#40155EEF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="OutlineBrush" Value="#CCF79009" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </nodify:Connection.Style>
                        </nodify:Connection>
                        <Border Canvas.Left="{Binding MidPoint.X}"
                                Canvas.Top="{Binding MidPoint.Y}"
                                IsHitTestVisible="False"
                                Background="White"
                                BorderBrush="{Binding Stroke}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5,1">
                            <TextBlock FontSize="10"
                                       Foreground="#344054"
                                       Text="{Binding Label}" />
                        </Border>
                    </Canvas>
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate>
                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                        <Border Background="White"
                                BorderBrush="#98A2B3"
                                BorderThickness="1.2"
                                CornerRadius="5">
                            <Grid Margin="11,9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#101828"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Name}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="8,0,0,0"
                                               Foreground="#667085"
                                               FontSize="10"
                                               Text="{Binding RuntimeState}" />
                                </DockPanel>
                                <TextBlock Grid.Row="1"
                                           Margin="0,6,0,0"
                                           Foreground="#475467"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{Binding NodeTypeId}" />
                                <Border Grid.Row="2"
                                        Margin="0,7,0,0"
                                        Padding="4,1"
                                        HorizontalAlignment="Left"
                                        Background="{Binding RuntimeStateBrush}"
                                        CornerRadius="2">
                                    <TextBlock FontSize="9" Foreground="White" Text="{Binding Description}" TextTrimming="CharacterEllipsis" MaxWidth="164" />
                                </Border>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding InputPorts}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <nodify:Connector Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="-7,2,0,2"
                                                      Background="#155EEF"
                                                      BorderBrush="White"
                                                      BorderThickness="2"
                                                      IsHitTestVisible="{Binding IsEditing}"
                                                      ToolTip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding OutputPorts}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <nodify:Connector Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="0,2,-7,2"
                                                      Background="#12B76A"
                                                      BorderBrush="White"
                                                      BorderThickness="2"
                                                      IsHitTestVisible="{Binding IsEditing}"
                                                      ToolTip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>
        </nodify:NodifyEditor>
    </Grid>
</UserControl>
